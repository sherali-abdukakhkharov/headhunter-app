<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!--
		The launcher name. "JobBridge" everywhere - it is a logotype and is not
		translated (HhBrandWordmark.text), so there is no InfoPlist.strings for it.
	-->
	<key>CFBundleDisplayName</key>
	<string>JobBridge</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!--
		The interface's languages (§2.4). iOS reports a preferred language to the
		app only if the bundle declares it, so without this list a phone set to
		Russian would arrive in Flutter as English. Uzbek is listed in both
		scripts because the app ships both, even where iOS itself offers neither.
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>uz</string>
		<string>uz-Cyrl</string>
		<string>ru</string>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>JobBridge</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!--
		HTTPS is the only encryption in the app, and it is the operating system's.
		Declaring that here answers App Store Connect's export-compliance question
		for every build, instead of it being asked - and blocking TestFlight - on
		each upload.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
		Demanded by App Store Connect, not by anything the app does. Build 47 was
		refused on 2026-11-27 with ITMS-90683 for these two keys: file_picker's
		Swift package compiles its photo and camera picker in unconditionally
		(PICKER_MEDIA in its Package.swift), and Apple's upload scan requires a
		purpose string for any API the binary references, called or not.

		The app calls only the document picker (FileType.custom and .any), so no
		permission is ever requested and neither string is ever shown. That is
		why they are English only, with no InfoPlist.strings: if the media
		picker is ever used, translate them then. Each says only what the code
		behind it would do.

		The same e-mail named NSLocationWhenInUseUsageDescription as advisory,
		not required. Nothing in the app reads location, so it is not here.
	-->
	<key>NSCameraUsageDescription</key>
	<string>JobBridge uses the camera only when you choose to photograph a document to attach, such as your CV or a certificate.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>JobBridge uses your photos only when you choose one to attach, such as a picture of your CV or a certificate.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!--
		The same three the Android build allows, which declares no orientation
		lock. iPhone only (TARGETED_DEVICE_FAMILY = 1), so there is no ~ipad
		variant: an iPad runs this as an iPhone app and needs no list of its own.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
