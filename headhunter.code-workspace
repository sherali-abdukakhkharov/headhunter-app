{
  "folders": [
    {
      "name": "headhunter-app (Flutter)",
      "path": "."
    },
    {
      "name": "headhunter-backend (NestJS)",
      "path": "../headhunter-backend"
    }
  ],
  "settings": {
    "files.eol": "\n",
    "editor.formatOnSave": true,

    "[dart]": {
      "editor.defaultFormatter": "Dart-Code.dart-code",
      "editor.rulers": [80],
      "editor.selectionHighlight": false,
      "editor.tabCompletion": "onlySnippets",
      "editor.wordBasedSuggestions": "off"
    },

    "[typescript]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[json]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[jsonc]": {
      "editor.defaultFormatter": "biomejs.biome"
    },

    "eslint.workingDirectories": [
      { "directory": "../headhunter-backend", "changeProcessCWD": true }
    ],

    "dart.lineLength": 80,
    "dart.flutterSdkPath": "D:\\Dev\\sdk\\flutter",

    "search.exclude": {
      "**/.dart_tool": true,
      "**/build": true,
      "**/dist": true,
      "**/node_modules": true,
      "**/*.g.dart": true
    },
    "files.watcherExclude": {
      "**/.dart_tool/**": true,
      "**/build/**": true,
      "**/dist/**": true,
      "**/node_modules/**": true
    }
  },
  "extensions": {
    "recommendations": [
      "Dart-Code.dart-code",
      "Dart-Code.flutter",
      "biomejs.biome",
      "dbaeumer.vscode-eslint"
    ]
  }
}
