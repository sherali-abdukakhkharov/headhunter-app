# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Staging area for a release artifact built by hand, e.g. when Actions is
# unavailable and the APK is uploaded to a GitHub Release manually. The CI
# workflow uses the same path. A 52MB binary must never enter git history -
# releases carry attachments, the repository does not.
/dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# gen-l10n diagnostic output. Regenerated on every build; the ARB key-set parity
# test is what actually enforces completeness, not this file.
/l10n_untranslated.json

# QA audit evidence: the screenshots, UI dumps and API logs behind each MT-nnn
# finding in mobile-test-audit.md. 205 files and ~25MB per pass, and a pass
# lands with every audited release, so this grows without bound in a place git
# never forgets. The audit's own prose carries the finding; the image is
# corroboration for whoever is reading it that week.
#
# Consequence, accepted deliberately: the `evidence/...` links in
# mobile-test-audit.md resolve only on the machine the audit ran on. Anyone who
# needs a screenshot asks the owner for the directory.
/evidence/
