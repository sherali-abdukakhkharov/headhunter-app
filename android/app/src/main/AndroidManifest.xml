<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for all API calls. The Flutter template only declares this in the
         debug/ and profile/ manifests, so release builds would fail every request. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Push (§9.2). Android 13 turned notifications into a runtime permission,
         so this declaration only makes the *request* possible - PushMessaging
         asks for it, and everything §9.2 shows keeps working when the answer is
         no, because the in-app list is the record and push is a copy of it.

         On Android 12 and below the permission does not exist and the platform
         ignores the declaration; notifications are granted by installing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- android:label comes from the per-flavor `appName` manifestPlaceholder in
         build.gradle.kts. A hardcoded label would make all three flavors
         identical on the home screen, defeating side-by-side installation. -->
    <application
        android:label="${appName}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Hands a downloaded attachment to whatever app can display it.

             `${applicationId}` and not a literal: the three flavors have three
             application ids, and two installed apps declaring the same provider
             authority cannot coexist - which would break the side-by-side
             installation §12.1 exists to give us.

             `exported="false"` with `grantUriPermissions="true"` is the whole
             security model: nothing can bind to this provider, and a viewer sees
             one file for as long as the intent that named it lives.
             res/xml/file_paths.xml narrows it to a single cache subdirectory.

             There is deliberately **no `<queries>` entry for ACTION_VIEW**.
             Android 11's package visibility filters `queryIntentActivities` and
             `resolveActivity`, not `startActivity` with an implicit intent - and
             the Kotlin side launches directly and catches
             ActivityNotFoundException instead of asking first. A broad `<queries>`
             block would widen what this app can see for no gain. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Which channel FCM posts an incoming notification to (§9.2).

             Android 8 requires every notification to name a channel, and a
             payload that names none lands in FCM's own fallback channel - shown
             to the user as "Miscellaneous", and at DEFAULT importance, which
             means **no heads-up banner**. The backend deliberately sends
             `priority: HIGH` for things a person is waiting on, so accepting the
             fallback would quietly discard half of what it asked for.

             The channel itself is created by MainActivity, not here: a channel
             needs a *name a person reads*, this app has four interface variants
             (§2.4) and the one in use is a choice made inside the app rather
             than the phone's locale, so the name comes from Dart. Creating a
             channel is idempotent and updates the name, so switching language
             renames it on the next launch.

             If the channel is somehow missing when a push lands, FCM falls back
             as above - degraded, not broken. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jobbridge_notifications" />

        <!-- The status-bar icon, and the accent behind it.

             Without the icon FCM falls back to the application icon, and since
             API 21 a small icon is an **alpha mask**: every opaque pixel is
             painted in the system tint. `ic_launcher` is a full-bleed navy
             plate, so the fallback is a solid white square on every
             notification. res/drawable/ic_notification.xml carries the mark as
             a silhouette instead.

             The colour tints the icon in the shade. Reusing brand_turquoise
             rather than adding a colour: it is the mark's own accent and
             already mirrored from HhColors. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand_turquoise" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
