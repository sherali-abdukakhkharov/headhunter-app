<?xml version="1.0" encoding="utf-8"?>
<!--
  The night configuration exists only to stop the platform from choosing dark
  values behind an app that has no dark variant. Both windows therefore carry the
  same colours as values/styles.xml rather than inheriting a black theme:
  `Theme.Black.NoTitleBar` was giving a night-mode device a dark frame behind a
  light UI.

  If the design ever ships a dark theme, this is the file that stops being a copy.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/app_surface</item>
    </style>
</resources>
