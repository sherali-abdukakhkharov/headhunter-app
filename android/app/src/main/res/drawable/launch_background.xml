<?xml version="1.0" encoding="utf-8"?>
<!--
  The base-configuration copy of drawable-v21/launch_background.xml.

  `minSdk` is 24, so drawable-v21 always wins and nothing reads this file. It is
  kept because `@drawable/launch_background` having no base-config variant is the
  kind of thing a future `flutter create` diff or an AGP lint pass will want to
  put back, and a missing base resource fails at runtime rather than at build.

  Keep it identical to the v21 copy. Any reasoning belongs there, not duplicated
  here.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_navy" />
</layer-list>
