<!--
  The launcher icon for API 24 and 25, which have no adaptive icons.

  ## Why this file exists, and why it is a vector

  `minSdk` is 24, so two API levels predate `<adaptive-icon>` and get whatever
  `@mipmap/ic_launcher` resolves to for them. Resource matching gives `anydpi`
  precedence over the density qualifiers and excludes `anydpi-v26` below API 26,
  so 26+ takes the adaptive icon next door and 24/25 take this one. That is the
  same mechanism every adaptive-icon setup already relies on, used one level
  further down.

  It is a vector because there is no rasteriser on this machine, and a vector is
  the better answer anyway: one file instead of five PNGs that can drift, and
  `<vector>` has been supported as a launcher icon since API 21.

  **This is the one file here that needs checking on a real API 24 or 25 device.**
  Everything else in this directory is exercised by every modern launcher.

  ## Why it draws its own plate when the design says not to

  The design says "no rounded-rect drawn *into* the artwork — the OS supplies the
  shape", and on every surface it covers that is true: iOS masks, adaptive masks,
  the 1024 master. API 24/25 is the one case it does not cover, and there the OS
  supplies nothing — a full-bleed square would ship as a hard-edged navy tile. So
  the plate is drawn here and only here, at the icon specimens' own radius (22 of
  96 on the master, 23%), and the mark takes the **56%** square-and-squircle
  ratio rather than the adaptive 48%, because nothing will mask this to a circle.

    plate radius = 0.23 x 108 = 24.84
    mark width   = 0.56 x 108 = 60.48
    mark height  = 60.48 x 19.8 / 23 = 52.0654
    outer group  = scale 2.629565 (= 60.48 / 23), translate (23.76, 27.96730)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FF0B2545"
        android:pathData="M24.84,0 L83.16,0 A24.84,24.84 0 0 1 108,24.84 L108,83.16 A24.84,24.84 0 0 1 83.16,108 L24.84,108 A24.84,24.84 0 0 1 0,83.16 L0,24.84 A24.84,24.84 0 0 1 24.84,0 Z" />

    <group
        android:scaleX="2.629565"
        android:scaleY="2.629565"
        android:translateX="23.76"
        android:translateY="27.96730">
        <group
            android:translateX="-4.5"
            android:translateY="-6.2">

            <!-- Left figure: the candidate. -->
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M5,9.8a3.6,3.6 0 1,0 7.2,0a3.6,3.6 0 1,0 -7.2,0" />
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M4.5 26C4.5 18.5 5.8 13.2 8.6 13.2C11.5 13.2 13.4 12.4 15.2 11.8L15.2 17.5C12.5 18.2 10.5 20.5 10.5 26Z" />

            <!-- Right figure: the employer. -->
            <path
                android:fillColor="#FF12B0BE"
                android:pathData="M19.8,9.8a3.6,3.6 0 1,0 7.2,0a3.6,3.6 0 1,0 -7.2,0" />
            <path
                android:fillColor="#FF12B0BE"
                android:pathData="M27.5 26C27.5 18.5 26.2 13.2 23.4 13.2C20.5 13.2 18.6 12.4 16.8 11.8L16.8 17.5C19.5 18.2 21.5 20.5 21.5 26Z" />
        </group>
    </group>
</vector>
