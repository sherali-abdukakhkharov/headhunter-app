<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts. Removed automatically once the Flutter
         engine draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Applied as soon as the process has started, and left behind the Flutter
         UI while it runs.

         `@color/app_surface`, not `?android:colorBackground`: the platform value
         is white on a light device and near-black on a dark one, and this app has
         no dark variant, so a night-mode device would show a dark frame behind a
         light UI for any moment Flutter's surface was not yet opaque. The app
         surface is the only colour that is never wrong here. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/app_surface</item>
    </style>
</resources>
