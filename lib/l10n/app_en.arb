  },
  "adminAuditVacancyModerated": "Vacancy moderated",
  "@adminAuditVacancyModerated": {
    "description": "`vacancy.moderated`."
  },
  "adminAuditComplaintReviewed": "Complaint reviewed",
  "@adminAuditComplaintReviewed": {
    "description": "`complaint.reviewed`."
  },
  "adminAuditUserWarned": "User warned",
  "@adminAuditUserWarned": {
    "description": "`user.warned`. The action that changes no status, which is why the audit log has to exist at all."
  },
  "adminAuditUserRestricted": "User restricted",
  "@adminAuditUserRestricted": {
    "description": "`user.restricted`."
  },
  "adminAuditUserBlocked": "User blocked",
  "@adminAuditUserBlocked": {
    "description": "`user.blocked`."
  },
  "adminAuditUserUnblocked": "User unblocked",
  "@adminAuditUserUnblocked": {
    "description": "`user.unblocked`."
  },
  "adminAuditRestrictionExpired": "Restriction expired",
  "@adminAuditRestrictionExpired": {
    "description": "`user.restriction_expired` — written by BR-10's guard rather than by a person, which is why the actor line on such a row is the platform."
  },
  "adminAuditAccountPurged": "Account deleted",
  "@adminAuditAccountPurged": {
    "description": "`user.purged` — BR-14's deletion. The one action whose target no longer exists when the row is read."
  },
  "adminAuditWalletAdjusted": "Wallet adjusted",
  "@adminAuditWalletAdjusted": {
    "description": "`wallet.adjusted` — §10.5's manual adjustment, the one route that can create Coins from nothing."
  },
  "adminAuditDictionaryCreated": "Dictionary item added",
  "@adminAuditDictionaryCreated": {
