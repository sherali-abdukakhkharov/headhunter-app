  "adminAuditDictionaryUpdated": "Dictionary item changed",
  "@adminAuditDictionaryUpdated": {
    "description": "`dictionary.item_updated` (§10.3)."
  },
  "adminAuditDictionaryDeactivated": "Dictionary item deactivated",
  "@adminAuditDictionaryDeactivated": {
    "description": "`dictionary.item_deactivated` (§10.3)."
  },
  "adminAuditDictionaryMerged": "Dictionary items merged",
  "@adminAuditDictionaryMerged": {
    "description": "`dictionary.items_merged` (§10.3)."
  },
  "adminUserAuditAbout": "Everything done to this account",
  "@adminUserAuditAbout": {
    "description": "The audit log filtered to this account — §10.4's \"what was done to this thing\". Distinct from the status trail below it: BR-08 records what the account's status became, and a warning changes no status."
  },
  "adminUserAuditBy": "Everything this administrator has done",
  "@adminUserAuditBy": {
    "description": "The audit log filtered to this administrator. Offered only on an account that holds the admin role, because only an administrator ever writes an audit row and an empty answer would read as a bug."
