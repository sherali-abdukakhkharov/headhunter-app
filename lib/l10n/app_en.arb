  "candidateHomeTitle": "Home",
  "@candidateHomeTitle": {
    "description": "§5.5's candidate home."
  },
  "candidateHomeInvitations": "{count, plural, one{{count} invitation awaits your answer} other{{count} invitations await your answer}}",
  "@candidateHomeInvitations": {
