  "candidateHomeProfileIncomplete": "Finish your profile",
  "@candidateHomeProfileIncomplete": {
    "description": "A profile that has been started and is not finished."
  },
  "candidateHomeProfileBody": "A fuller profile is matched to more of the work employers are posting.",
  "@candidateHomeProfileBody": {
    "description": "Why finishing it is worth doing, for a profile employers can already find."
  },
  "candidateHomeProfileHidden": "Employers cannot find you yet — your profile has to be complete before it appears in a search.",
  "@candidateHomeProfileHidden": {
    "description": "BR-02 is a threshold rather than a preference: an incomplete profile is not searchable at all, and that is the answer to \"why is nobody inviting me\"."
  },
  "candidateHomeRecommended": "Recommended for you",
  "@candidateHomeRecommended": {
