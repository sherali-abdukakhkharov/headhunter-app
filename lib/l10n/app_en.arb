  },
  "invitationAwaitingYou": "Awaiting your answer",
  "@invitationAwaitingYou": {
    "description": "The candidate's side of §8.2's `sent`. The employer's list says \"Sent\"; the recipient's says what it means for them, because \"Sent\" on an inbox card reads as though they sent it."
  },
  "employerTypeFirst": "Choose who is hiring above. The details asked for depend on it.",
  "@employerTypeFirst": {
    "description": "Shown in place of the form until the type question is answered. Which fields exist *is* the answer, so a form drawn before it is a form drawn for a guess."
  },
  "employerRequired": "Required",
  "@employerRequired": {
