{
  "@@locale": "en",

  "appTitle": "HeadHunter",
  "@appTitle": {
    "description": "Application name. Brand term - left untranslated in every locale."
  },

  "commonRetry": "Try again",
  "@commonRetry": {
    "description": "Action on an error state. Every error state must offer one."
  },
  "commonCancel": "Cancel",
  "@commonCancel": {
    "description": "Dismisses a dialog or sheet without applying changes."
  },
  "commonSave": "Save",
  "@commonSave": {
    "description": "Commits a form."
  },
  "commonNext": "Next",
  "@commonNext": {
    "description": "Advances a multi-step flow."
  },
  "commonBack": "Back",
  "@commonBack": {
    "description": "Returns to the previous step."
  },
  "commonClose": "Close",
  "@commonClose": {
    "description": "Closes a sheet or full-screen surface."
  },
  "commonSearch": "Search",
  "@commonSearch": {
    "description": "Placeholder for a search input."
  },
  "commonSignOut": "Sign out",
  "@commonSignOut": {
    "description": "Ends the session at the user's request. Distinct from an expired session, which the user did not choose."
  },

  "stateLoading": "Loading…",
  "@stateLoading": {
    "description": "Accessible label for a loading state. Read by screen readers where the spinner itself carries no text."
  },
  "stateEmptyTitle": "Nothing here yet",
  "@stateEmptyTitle": {
    "description": "Heading for an empty list, as distinct from an error."
  },
  "stateEmptyBody": "There is nothing to show on this screen yet.",
  "@stateEmptyBody": {
    "description": "Body for an empty list."
  },
  "stateErrorTitle": "Something went wrong",
  "@stateErrorTitle": {
    "description": "Heading for a failed request."
  },
  "stateErrorBody": "The request could not be completed. Please try again.",
  "@stateErrorBody": {
    "description": "Generic error body, used when the server sent no localized message of its own."
  },
  "stateOfflineTitle": "No connection",
  "@stateOfflineTitle": {
    "description": "Heading shown when the device is offline. Distinct from a server error - the user can act on this one."
  },
  "stateOfflineBody": "Check your connection and try again.",
  "@stateOfflineBody": {
    "description": "Body for the offline state."
  },
  "statePermissionDeniedTitle": "Permission needed",
  "@statePermissionDeniedTitle": {
    "description": "Heading when an OS permission was refused."
  },
  "statePermissionDeniedBody": "Grant permission in Settings to continue.",
  "@statePermissionDeniedBody": {
    "description": "Body when an OS permission was refused."
  },

  "sessionExpired": "Your session has expired. Please sign in again.",
  "@sessionExpired": {
    "description": "Shown when refresh fails and the user is returned to onboarding."
  },

  "settingsLanguage": "Language",
  "@settingsLanguage": {
    "description": "Label for the interface-language setting."
  },

  "roleCandidate": "Candidate",
  "@roleCandidate": {
    "description": "Role name. Someone looking for work."
  },
  "roleEmployer": "Employer",
  "@roleEmployer": {
    "description": "Role name. Someone posting vacancies - a company or an individual."
  },
  "roleAdmin": "Administrator",
  "@roleAdmin": {
    "description": "Role name. Platform moderator."
  },

  "navHome": "Home",
  "@navHome": {
    "description": "Bottom-nav tab. Candidate and employer home. LENGTH-CRITICAL: the bar reserves two label lines at a constant 70pt and clips beyond them - keep to two lines at 320pt and 2.0x text scale, or add a soft hyphen."
  },
  "navVacancies": "Vacancies",
  "@navVacancies": {
    "description": "Bottom-nav tab. The vacancy feed for a candidate, the employer's own vacancies for an employer. Length-critical - see navHome."
  },
  "navApplications": "Applications",
  "@navApplications": {
    "description": "Bottom-nav tab, candidate. The candidate's own applications and their stages (§8.1). Length-critical - see navHome."
  },
  "navMessages": "Messages",
  "@navMessages": {
    "description": "Bottom-nav tab. Conversations (§9.1). Length-critical - see navHome."
  },
  "navProfile": "Profile",
  "@navProfile": {
    "description": "Bottom-nav tab, candidate. Their own profile (§5). Length-critical - see navHome."
  },
  "navCandidates": "Candidates",
  "@navCandidates": {
    "description": "Bottom-nav tab, employer. Candidate search and saved candidates (§7). Length-critical - see navHome."
  },
  "navCompany": "Company",
  "@navCompany": {
    "description": "Bottom-nav tab, employer. The employer's own profile and verification state (§6.1) - used for an individual employer too, so avoid wording that implies a legal entity."
  },
  "navDashboard": "Dashboard",
  "@navDashboard": {
    "description": "Bottom-nav tab, administrator. The counters of §10.1. Length-critical - see navHome."
  },
  "navQueue": "Moderation",
  "@navQueue": {
    "description": "Bottom-nav tab, administrator. Covers both queues of §10.2 - employer verification and vacancy moderation - so it must not name only one of them. Length-critical - see navHome."
  },
  "navComplaints": "Complaints",
  "@navComplaints": {
    "description": "Bottom-nav tab, administrator. The complaint review queue (§10.2). Length-critical - see navHome."
  },
  "navUsers": "Users",
  "@navUsers": {
    "description": "Bottom-nav tab, administrator. User search and warn/restrict/block (§10.2, UAT-14). Length-critical - the Uzbek and Russian words are far longer than the English and carry a soft hyphen."
  },
  "navDictionaries": "Dictionaries",
  "@navDictionaries": {
    "description": "Bottom-nav tab, administrator. Dictionary management with all four localized labels (§10.3). Length-critical - see navHome."
  },

  "blockedTitle": "Account blocked",
  "@blockedTitle": {
    "description": "BR-10. Heading of the screen a blocked account is held on. The app must explain the restriction rather than fail mysteriously."
  },
  "blockedBody": "An administrator has blocked this account. You cannot use the app until the block is lifted.",
  "@blockedBody": {
    "description": "BR-10. Shown only when the administrator supplied no reason; when they did, their reason is displayed verbatim instead and is never translated client-side (§2.4)."
  },

  "authSignInTitle": "Sign in",
  "@authSignInTitle": {
    "description": "Heading of the sign-in screen (§4.1)."
  },
  "authPhoneLabel": "Phone number",
  "@authPhoneLabel": {
    "description": "Persistent label above the phone field (§4.1 step 3). The +998 country code is a static prefix inside the field, so this labels the national part only."
  },
  "authPhoneHint": "90 123 45 67",
  "@authPhoneHint": {
    "description": "Placeholder showing the nine-digit shape of an Uzbek subscriber number. Digits only - do not translate, and do not localize the grouping."
  },
  "authPhoneInvalid": "Enter a 9-digit number, for example 90 123 45 67.",
  "@authPhoneInvalid": {
    "description": "Client-side check before the send call: the national part is not nine digits. Checked here only to save the user a round trip; the server validates independently."
  },
  "authSendCode": "Get a code",
  "@authSendCode": {
    "description": "Primary action on the phone screen (§4.1). Deliberately not 'Sign in' or 'Register' - phone-only identity makes those the same act, and the user does not yet know which one this is."
  },
  "authCodeTitle": "Enter the code",
  "@authCodeTitle": {
    "description": "Heading of the code screen, the second step of sign-in (§4.1)."
  },
  "authCodeSentTo": "We sent a code to {phone}.",
  "@authCodeSentTo": {
    "description": "Confirms which number the code went to, so a mistyped digit is caught here rather than after the code fails to arrive.",
    "placeholders": {
      "phone": {
        "type": "String",
        "example": "+998 90 123 45 67"
      }
    }
  },
  "authCodeLabel": "Code",
  "@authCodeLabel": {
    "description": "Persistent label above the one-time code field."
  },
  "authCodeInvalid": "Enter the {length}-digit code.",
  "@authCodeInvalid": {
    "description": "Client-side check before the verify call: the field does not hold a complete code. Length is a placeholder because OTP_LENGTH is server configuration (§4.2) - never hardcode six.",
    "placeholders": {
      "length": {
        "type": "int",
        "example": "6"
      }
    }
  },
  "authVerifyCode": "Confirm",
  "@authVerifyCode": {
    "description": "Primary action on the code screen."
  },
  "authChangePhone": "Change number",
  "@authChangePhone": {
    "description": "Returns to the phone field. Present because the number is shown above it and a user who spots a typo needs somewhere to go that is not the back gesture."
  },
  "authResendCode": "Send again",
  "@authResendCode": {
    "description": "Requests a fresh code. Enabled only once the server's resend delay has passed (§4.2)."
  },
  "authResendIn": "Send again in {seconds} s",
  "@authResendIn": {
    "description": "The resend action while the delay is still running. Shows the remaining seconds so the user knows the button is waiting rather than broken.",
    "placeholders": {
      "seconds": {
        "type": "int",
        "example": "42"
      }
    }
  },
  "authCodeResent": "A new code is on its way.",
  "@authCodeResent": {
    "description": "Confirmation after a successful resend. Needed because the visible result of a resend is otherwise only the countdown restarting."
  },
  "authTelegramSignIn": "Log in with Telegram",
  "@authTelegramSignIn": {
    "description": "DEPRECATED 2026-08-05, kept with the Telegram sign-in code it labels; nothing renders it. 'Telegram' is a product name and stays untranslated in every locale, including the Cyrillic ones."
  },
  "authTermsAgree": "I accept the Terms of Service and the Privacy Policy",
  "@authTermsAgree": {
    "description": "§4.1 step 2. Consent must be given before sign-in, and it is not optional - the button stays disabled until this is checked."
  },
  "authSignInFailed": "Could not sign in with Telegram. Please try again.",
  "@authSignInFailed": {
    "description": "DEPRECATED with the Telegram flow. Telegram or its SDK failed for a reason the user cannot act on beyond retrying."
  },
  "authSignInNoConnection": "No connection to Telegram. Check your internet and try again.",
  "@authSignInNoConnection": {
    "description": "DEPRECATED with the Telegram flow. Network failure while contacting Telegram, as distinct from our own server being unreachable."
  },
  "authSignInUnavailable": "Telegram sign-in is not available in this build.",
  "@authSignInUnavailable": {
    "description": "DEPRECATED with the Telegram flow. This build's application id has no redirect URI registered with BotFather, so a login cannot start."
  }
}
