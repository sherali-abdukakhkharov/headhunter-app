  "walletCorrectionExplained": "This entry corrects an earlier one. The original stays in the history — corrections are added, never written over.",
  "@walletCorrectionExplained": {
    "description": "Shown on E-53 for an adjustment or a reversal. BR-24 in one sentence, at the moment an employer is most likely to wonder why they can see both entries."
  },
  "navInvitations": "Invitations",
  "@navInvitations": {
    "description": "Employer invitations (§8.2). Used on the segmented control inside the candidate's Applications tab, not as a bottom-nav label — the five-tab cap is full."
  },
  "invitationSent": "Sent",
  "@invitationSent": {
    "description": "Invitation status: delivered and not yet answered. Also the fallback label for a status this app version does not recognise."
  },
  "invitationDetailsRequested": "Details requested",
  "@invitationDetailsRequested": {
    "description": "Invitation status: the candidate asked a question, so it now waits on the employer. Not a final state — accepting or declining afterwards is allowed."
  },
  "invitationAccepted": "Accepted",
  "@invitationAccepted": {
    "description": "Invitation status: the candidate accepted, which is what opens contact details to that employer (BR-09)."
  },
  "invitationDeclined": "Declined",
  "@invitationDeclined": {
    "description": "Invitation status: the candidate declined. Final. Shown to both sides, so the wording must not read as a reproach to the person who chose it."
  },
  "invitationAccept": "Accept",
  "@invitationAccept": {
    "description": "Button. A verb where invitationAccepted is a state — a past participle on a button reads as a label, not an action."
  },
  "invitationDecline": "Decline",
  "@invitationDecline": {
    "description": "Button."
  },
  "invitationRequestDetails": "Ask a question",
  "@invitationRequestDetails": {
    "description": "Button for §8.2's \"Request details\". Phrased as asking a question rather than requesting details, because that is what the candidate actually does with it and it makes the empty state of the field obvious."
  },
  "invitationsInboxEmpty": "Employers who invite you to a vacancy will appear here.",
  "@invitationsInboxEmpty": {
    "description": "Empty state for the candidate's invitation inbox. Says what would fill it rather than that it is empty."
  },
  "invitationGeneral": "General invitation",
  "@invitationGeneral": {
    "description": "§8.2's second shape: an invitation to work rather than to a specific vacancy. Shown first on the card, because the absence of a posting is the first thing the candidate needs to know."
  },
  "invitationOpenVacancy": "Open vacancy",
  "@invitationOpenVacancy": {
    "description": "Opens the full vacancy behind a vacancy-scoped invitation."
  },
  "invitationVacancyLoading": "Loading the vacancy…",
  "@invitationVacancyLoading": {
    "description": "Placeholder line while the vacancy behind an invitation is fetched. A line of text rather than a spinner, so a list of cards does not flicker."
  },
  "invitationVacancyUnavailable": "The vacancy could not be loaded.",
  "@invitationVacancyUnavailable": {
    "description": "A real failure fetching the vacancy behind an invitation, as distinct from vacancyGoneTitle, which is the ordinary 404 for a vacancy that has closed since."
  },
  "invitationVacancyUntitled": "Vacancy",
  "@invitationVacancyUntitled": {
    "description": "Fallback when the vacancy behind an invitation has no title yet."
  },
  "invitationYourReply": "Your reply",
  "@invitationYourReply": {
    "description": "Label above the candidate's own note, played back to them on the invitation card."
  },
  "invitationPayRange": "{from} – {to} UZS",
  "@invitationPayRange": {
    "description": "A general invitation's stated pay range. Only general invitations carry pay of their own — a vacancy invitation's lives on the vacancy.",
    "placeholders": {
      "from": {
        "type": "int",
        "format": "decimalPattern"
      },
      "to": {
        "type": "int",
        "format": "decimalPattern"
      }
    }
  },
  "invitationPayFrom": "From {amount} UZS",
  "@invitationPayFrom": {
    "description": "A general invitation with only a lower bound on pay.",
    "placeholders": {
      "amount": {
        "type": "int",
        "format": "decimalPattern"
      }
    }
  },
  "invitationPayUpTo": "Up to {amount} UZS",
  "@invitationPayUpTo": {
    "description": "A general invitation with only an upper bound on pay.",
    "placeholders": {
      "amount": {
        "type": "int",
        "format": "decimalPattern"
      }
    }
  },
  "invitationAcceptTitle": "Accept this invitation?",
  "@invitationAcceptTitle": {
    "description": "Title of the accept confirmation sheet."
  },
  "invitationAcceptDiscloses": "Accepting shares your phone number, e-mail address and CV with this employer, and cannot be undone.",
  "@invitationAcceptDiscloses": {
    "description": "The disclosure, shown before the accept button. Names the three protected fields rather than saying \"your contact details\": a candidate cannot weigh a category, and these are exactly the three §11.1 protects. Also states irreversibility, because §8.2 has no transition out of accepted."
  },
  "invitationDeclineTitle": "Decline this invitation?",
  "@invitationDeclineTitle": {
    "description": "Title of the decline confirmation sheet."
  },
  "invitationDeclineFinal": "Your contact details stay private. Declining is final, but the employer may invite you again later.",
  "@invitationDeclineFinal": {
    "description": "Shown before the decline button. Says what stays private, that the status is final, and that a decline is not a permanent block — the last part matters because the alternative reading is that declining once ends the relationship."
  },
  "invitationRequestDetailsTitle": "Ask the employer a question",
  "@invitationRequestDetailsTitle": {
    "description": "Title of the sheet behind §8.2's \"Request details\"."
  },
  "invitationRequestDetailsBody": "You can still accept or decline afterwards. Your contact details stay private until you accept.",
  "@invitationRequestDetailsBody": {
    "description": "Shown before the ask-a-question button. States both things the candidate needs: that asking is not a decision, and that it discloses nothing."
  },
  "invitationQuestionLabel": "Your question",
  "@invitationQuestionLabel": {
    "description": "Field label when asking for details. Required, unlike the note on the other two responses."
  },
  "invitationQuestionHint": "For example: where exactly is the work, and when does it start?",
  "@invitationQuestionHint": {
    "description": "Hint under the question field. An example rather than an instruction, because the field is empty and a blank box invites a blank answer."
  },
  "invitationNoteLabel": "Message (optional)",
  "@invitationNoteLabel": {
    "description": "Field label on accept and decline. Marked optional in the label itself, so a candidate declining is never left wondering whether a reason is required."
  },
  "invitationNoteHint": "Anything you would like the employer to know.",
  "@invitationNoteHint": {
    "description": "Hint under the optional message field."
  },
  "invitationAlreadyAnswered": "This invitation has already been answered",
  "@invitationAlreadyAnswered": {
    "description": "Title over the server's refusal in the response sheet. §8.2's `invitation.final` and `invitation.response_not_allowed` both mean the invitation moved elsewhere — usually another device — so the sentence explains the refusal rather than blaming the tap."
  },
  "commonChoose": "Choose",
  "@commonChoose": {
    "description": "Placeholder in a read-only field that opens a picker."
  },
  "invitationSendTitle": "Send invitation",
  "@invitationSendTitle": {
    "description": "Screen title for the compose form. Deliberately different wording from invitationSend, the button, so the two are distinguishable."
  },
  "invitationSend": "Send",
  "@invitationSend": {
    "description": "The submit button on the compose form."
  },
  "invitationSendFree": "Sending is free. Contact details open only if the candidate accepts.",
  "@invitationSendFree": {
    "description": "States the resolution of the section 8.2 contradiction where the employer will act on it. Worth saying explicitly: an employer who thinks inviting costs Coins will not invite, and section 7.4 own example needs dozens of invitations."
  },
  "invitationToVacancy": "To a vacancy",
  "@invitationToVacancy": {
    "description": "One of the two invitation shapes; the other is invitationGeneral."
  },
  "invitationVacancyLabel": "Choose a vacancy",
  "@invitationVacancyLabel": {
    "description": "Label above the list of the employer open vacancies."
  },
  "invitationNoOpenVacancyTitle": "No open vacancies",
  "@invitationNoOpenVacancyTitle": {
    "description": "Only open vacancies may carry an invitation (BR-06) — the server refuses the rest with invitation.vacancy_not_open."
  },
  "invitationNoOpenVacancyBody": "An invitation can only point at an active vacancy. You can still send a general work invitation.",
  "@invitationNoOpenVacancyBody": {
    "description": "A notice rather than an error, because the general shape is a way forward that needs nothing published."
  },
  "invitationOccupation": "Occupation",
  "@invitationOccupation": {
    "description": "Required on a general invitation — it is what makes the invitation about something."
  },
  "invitationRegion": "Region",
  "@invitationRegion": {
    "description": "Optional on a general invitation."
  },
  "invitationDistrict": "District",
  "@invitationDistrict": {
    "description": "Optional, and scoped to the chosen region — districts are children of the region dictionary, not a type of their own."
  },
  "invitationNegotiable": "Pay is negotiable",
  "@invitationNegotiable": {
    "description": "Excludes a range rather than qualifying one: a negotiable figure and a stated one are different answers."
  },
  "invitationSalaryFrom": "Pay from",
  "@invitationSalaryFrom": {
    "description": "Lower bound, in som."
  },
  "invitationSalaryTo": "Pay to",
  "@invitationSalaryTo": {
    "description": "Upper bound, in som."
  },
  "invitationSalaryPeriod": "Per",
  "@invitationSalaryPeriod": {
    "description": "A payment_period dictionary id — per month, per day, per shift."
  },
  "invitationSchedule": "Schedule",
  "@invitationSchedule": {
    "description": "Free text by design: a general invitation is a message, and the structured version of a schedule is what publishing a vacancy is for."
  },
  "invitationScheduleHint": "For example: six days a week, mornings",
  "@invitationScheduleHint": {
    "description": "Hint under the schedule field."
  },
  "invitationMessageLabel": "Message (optional)",
  "@invitationMessageLabel": {
    "description": "The employer own words, shown to the candidate verbatim and never translated. Marked optional in the label."
  },
  "invitationMessageHint": "What you would like the candidate to know",
  "@invitationMessageHint": {
    "description": "Hint under the message field."
  },
  "invitationQuotaRemaining": "{remaining} of {limit} invitations left today",
  "@invitationQuotaRemaining": {
    "description": "The daily cap, entirely the server figures (section 12.3.1). `limit` is the effective total — the client deliberately does not model a free tier and a purchased one, so a future purchase raises the number and this string is already correct.",
    "placeholders": {
      "remaining": {
        "type": "int"
      },
      "limit": {
        "type": "int"
      }
    }
  },
  "invitationQuotaResets": "Resets at {at}",
  "@invitationQuotaResets": {
    "description": "A calendar boundary in the platform time zone, not a rolling window — \"it resets at midnight\" is something an employer can plan a day around.",
    "placeholders": {
      "at": {
        "type": "String"
      }
    }
  },
  "invitationQuotaSpentTitle": "Today’s invitations are used up",
  "@invitationQuotaSpentTitle": {
    "description": "Warning-toned rather than an error: the employer did nothing wrong and the remedy is a clock."
  },
  "invitationAlreadySentTitle": "Already invited",
  "@invitationAlreadySentTitle": {
    "description": "The server invitation.already_invited — a fact rather than a failure. One open invitation per candidate per vacancy; answering frees the slot."
  },
  "invitationSentConfirm": "Invitation sent",
  "@invitationSentConfirm": {
    "description": "Confirmation after a successful send. A transient toast rather than an inline banner, unlike the unlock, and the difference is deliberate: an unlock carries figures somebody may want to read twice, while this carries none — the invitation itself is now in the sent list, which is where it belongs."
  },
  "invitationsSentTitle": "Invitations sent",
  "@invitationsSentTitle": {
    "description": "The employer's half of section 8.2, and the title of the screen the section 7.4 counts open. Deliberately not \"My invitations\", which the candidate's inbox could equally be called."
  },
  "invitationsSentEmpty": "Candidates you invite will appear here.",
  "@invitationsSentEmpty": {
    "description": "The unfiltered empty list. States what would fill it rather than that it is empty, which the title above it already says."
  },
  "invitationsSentNoMatch": "No invitations with this status. Clear the filter to see everything you have sent.",
  "@invitationsSentNoMatch": {
    "description": "A filter that matched nothing, which is a different fact from having invited nobody: this one is fixed by clearing the filter. Telling an employer looking at \"Declined\" that they have invited nobody would simply be false."
  },
  "invitationsSentForVacancy": "This vacancy only",
  "@invitationsSentForVacancy": {
    "description": "Shown when the list was opened from one vacancy, so the server is narrowing it. The scope is stated because the list looks identical to the unscoped one otherwise, and a short list would read as \"few invitations\" rather than \"few on this vacancy\"."
  },
  "invitationFilterAll": "All",
  "@invitationFilterAll": {
    "description": "The unfiltered choice among the four statuses. Sends no `status` parameter rather than a fifth value, matching what the server means by its absence."
  },
  "invitationYourMessage": "What you wrote",
  "@invitationYourMessage": {
    "description": "Labels the employer's own message on their sent list. The counterpart of `invitationYourReply` on the candidate's side: the same words belong to whoever is reading, and only the label says whose they are."
  },
  "invitationCandidateReply": "Candidate's reply",
  "@invitationCandidateReply": {
    "description": "Labels the note a candidate attached when answering — and on \"Details requested\" it is a question waiting for an answer, which is why it is never trimmed to a preview."
  },
  "invitationContactOpenTitle": "Contact is open",
  "@invitationContactOpenTitle": {
    "description": "Heading on an accepted invitation. BR-09 grants contact details and files on an acceptance, at the same strength as an application and without a Coin."
  },
  "invitationContactOpenBody": "The candidate accepted, so their phone, e-mail and CV are on their profile. No unlock needed.",
  "@invitationContactOpenBody": {
    "description": "Says the unlock is not needed, because an employer who has just been shown a paid unlock on every other candidate screen has every reason to assume it is. Section 11.1 grants contact on an accepted invitation, and it survives the candidate hiding their profile."
  },
  "invitationOpenCandidate": "View candidate",
  "@invitationOpenCandidate": {
    "description": "Opens section 7.3's \"View profile\" from a sent invitation. A tap and never a prefetch: every open is a logged access to protected data (section 11.1), so thirty rows must not resolve thirty candidates."
  },
  "invitationCounts": "{invited} invited, {accepted} accepted",
  "@invitationCounts": {
    "description": "The first two of section 7.4 step 7's four counts; interviewed and hired are application stages and sit beside this from a different endpoint. `invited` is the **sum of every status** and not the count of `sent` — a candidate who answered was still invited, so reading `byStatus.sent` would make the number fall as replies arrive.",
    "placeholders": {
      "invited": {
        "type": "int"
      },
      "accepted": {
        "type": "int"
      }
    }
  },
  "fileNoViewer": "No app on this phone can open this file.",
  "@fileNoViewer": {
    "description": "Shown when an attachment downloaded fine and nothing installed can display it. Its own message rather than a generic failure: the bytes arrived and the server allowed it, so \"check your connection\" would send the reader looking in the wrong place. The remedy is on the device. Named for the file rather than for whose file it is — §9.1's chat attachments reach a candidate too, and the sentence is about the phone either way."
  },
  "dashboardActiveVacancies": "Active vacancies",
  "@dashboardActiveVacancies": {
    "description": "Header metric on section 6.2's dashboard. Counted from `isOpenForApplications`, which the server computes from the status *and* the deadline — so a vacancy that is active with yesterday's deadline is correctly not counted."
  },
  "dashboardOpenPositions": "Open positions",
  "@dashboardOpenPositions": {
    "description": "Section 6.2's \"total open positions\": the worker counts of the active vacancies added up. A vacancy that states no worker count contributes nothing rather than one."
  },
  "dashboardNewApplications": "New applications",
  "@dashboardNewApplications": {
    "description": "Applications still at `submitted` — nobody has opened them. Shown as an em dash while any per-vacancy count is still in flight, because a zero that becomes 34 a moment later was a wrong number rather than a stale one."
  },
  "dashboardAttention": "Needs your attention",
  "@dashboardAttention": {
    "description": "Heading over the dashboard's pending work. It comes before the metrics because the design says why: \"a recruiter opens this app to act, not to read numbers.\""
  },
  "dashboardAttentionClear": "Nothing is waiting on you.",
  "@dashboardAttentionClear": {
    "description": "Shown when the pending list is empty. Deliberately a plain positive line rather than an empty state with an illustration: an empty queue is the good outcome here, and drawing it as absence would read as a failure to load."
  },
  "dashboardVerificationTitle": "Verification is not complete",
  "@dashboardVerificationTitle": {
    "description": "The first pending row, and it outranks the rest: BR-03 means an unverified employer cannot publish a vacancy, search candidates or buy an unlock, so nothing else on the screen works until it is done."
  },
  "dashboardVacancyRejected": "Changes are required",
  "@dashboardVacancyRejected": {
    "description": "A vacancy a moderator sent back (section 6.4). Ranked above unread applicants because it is the only item on the list whose timing the employer does not control."
  },
  "dashboardUnreviewed": "{count} applications not yet reviewed",
  "@dashboardUnreviewed": {
    "description": "One pending row per vacancy with applications still at `submitted`.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "dashboardSavedCandidates": "{count} saved candidates",
  "@dashboardSavedCandidates": {
    "description": "Section 6.2's \"candidates to review\". Last in the pending list because it is a nudge rather than a blockage — nobody is waiting on it.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "dashboardHiring": "Hiring progress",
  "@dashboardHiring": {
    "description": "Heading over one meter per open vacancy, tracking section 7.4's counts against the target."
  },
  "dashboardHiredOf": "{hired} of {openings}",
  "@dashboardHiredOf": {
    "description": "Hires against the worker count (section 6.5). Absent when the vacancy states no worker count, because a denominator nobody set is not a target to measure against.",
    "placeholders": {
      "hired": {
        "type": "int"
      },
      "openings": {
        "type": "int"
      }
    }
  },
  "dashboardMeterHired": "Hired {count}",
  "@dashboardMeterHired": {
    "description": "Legend for the meter's first segment. The figure is in the label because an 8pt bar cannot be read off, and the design's own rule is that status is never colour alone.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "dashboardMeterInvited": "Invited {count}",
  "@dashboardMeterInvited": {
    "description": "Legend for the meter's second segment, and it counts invitations still **in the air** rather than every invitation ever sent: the three segments add up to the openings, so they have to be disjoint, and somebody already hired must not be counted twice. Non-terminal statuses only — the same set the candidate's inbox uses to decide whether an invitation can still be answered.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "dashboardMeterRemaining": "Remaining {count}",
  "@dashboardMeterRemaining": {
    "description": "Legend for the unfilled part of the meter. Drawn by *not* drawing it — the track showing through is the remainder — so this label is the only thing that names it.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "dashboardWallet": "Wallet",
  "@dashboardWallet": {
    "description": "Heading over section 6.2's wallet widget. The Top up action it also asks for is M13 and blocked on merchant credentials, so the tile shows the balance and its som value and leads to the ledger."
  },
  "accountTitle": "Account and security",
  "@accountTitle": {
    "description": "The one screen where somebody acts on the account rather than on the work: signed-in devices (section 4.2), signing out, and requesting deletion (BR-14)."
  },
  "accountDevices": "Signed-in devices",
  "@accountDevices": {
    "description": "Section 4.2's session list."
  },
  "accountDevicesBody": "If you see a device you do not recognise, end its session.",
  "@accountDevicesBody": {
    "description": "Says what the list is *for*. A list of devices with no instruction is a list most people scroll past; the reason to read it is that one of the rows might not be theirs."
  },
  "accountDeviceUnknown": "Unnamed device",
  "@accountDeviceUnknown": {
    "description": "A session whose device name and platform are both absent — an older build sent neither. Named rather than blank, because three empty lines read as a rendering failure rather than as missing data."
  },
  "accountLastUsed": "Last used {at}",
  "@accountLastUsed": {
    "description": "The wall clock the platform recorded, never converted to the device's zone: a session opened abroad would otherwise be dated in the wrong one (section 8.3).",
    "placeholders": {
      "at": {
        "type": "String"
      }
    }
  },
  "accountThisDevice": "This device",
  "@accountThisDevice": {
    "description": "Marks the row belonging to the phone in the reader's hand. The server decides it by comparing against the presented token, so it is not derivable client-side — and it is the one field that must not be wrong, because revoking that row signs the reader out."
  },
  "accountRevoke": "End session",
  "@accountRevoke": {
    "description": "Revokes one device. The verb, not \"Remove\": the device is not being removed from anything, its sign-in is being ended."
  },
  "accountRevokeTitle": "End this session?",
  "@accountRevokeTitle": {
    "description": "Confirmation for revoking another device."
  },
  "accountRevokeBody": "That device will have to sign in again.",
  "@accountRevokeBody": {
    "description": "States the consequence rather than asking for confirmation twice. Nothing is lost — the session ends, the account does not."
  },
  "accountRevokeCurrentTitle": "Sign out of this device?",
  "@accountRevokeCurrentTitle": {
    "description": "Revoking the current session *is* signing out, so the confirmation says so rather than repeating \"end session\" — a reader who taps it should not be surprised by what happens next."
  },
  "accountRevokeCurrentBody": "This is the device you are using. You will be signed out now.",
  "@accountRevokeCurrentBody": {
    "description": "The row is not hidden: somebody looking at a list of their devices must be able to act on the one in their hand. So the consequence is spelled out instead."
  },
  "accountRevokeAll": "End all sessions",
  "@accountRevokeAll": {
    "description": "Section 4.2's terminate-all. Offered only when more than one device is signed in — with one, it is the same button as Sign out under a longer name."
  },
  "accountRevokeAllTitle": "End every session?",
  "@accountRevokeAllTitle": {
    "description": "Confirmation for terminate-all."
  },
  "accountRevokeAllBody": "Every device will be signed out, including this one.",
  "@accountRevokeAllBody": {
    "description": "\"Including this one\" is the load-bearing half: \"every device\" is a phrase most people read as \"every *other* device\", and the surprise arrives after the action rather than before it."
  },
  "accountDelete": "Delete account",
  "@accountDelete": {
    "description": "BR-14. A section heading, and the section exists because an app that lets people create an account has to let them delete it from inside the app."
  },
  "accountDeleteBody": "Your profile, applications and messages will be removed. This cannot be undone.",
  "@accountDeleteBody": {
    "description": "Says what is lost before the button rather than after it. Deliberately no date: the server sends `purgeAfter: null` because the retention period is an open client question, so naming one would be promising something nobody has agreed."
  },
  "accountDeleteAction": "Request deletion",
  "@accountDeleteAction": {
    "description": "\"Request\", because that is what BR-14 does: the account moves to `deletion_requested` and a status-history row is written. Nothing is purged as the button is released, and a label saying \"Delete\" would describe a different operation."
  },
  "accountDeleteConfirmTitle": "Request account deletion?",
  "@accountDeleteConfirmTitle": {
    "description": "Confirmation for BR-14."
  },
  "accountDeleteConfirmBody": "We will start removing your account. You will not be able to undo this from the app.",
  "@accountDeleteConfirmBody": {
    "description": "\"Not from the app\" rather than \"not at all\": the request is a status change an administrator can see (section 10), so claiming it is absolutely final would be a stronger promise than the system makes."
  },
  "accountDeleteRequestedTitle": "Deletion requested",
  "@accountDeleteRequestedTitle": {
    "description": "Shown in place of the button once BR-14 has been recorded."
  },
  "accountDeleteRequestedBody": "Your request has been recorded. Support can tell you what happens next.",
  "@accountDeleteRequestedBody": {
    "description": "Points at support rather than at a date, because the server returns `purgeAfter: null` and there is no retention period to quote yet."
  },
  "filtersRegion": "Region or district",
  "@filtersRegion": {
    "description": "One place, not a set: the feed query takes a single `regionId`. Both are ids in the **region** dictionary, since districts are its children (section 5.1) rather than a type of their own, so choosing a district sets `regionId` to it."
  },
  "filtersEmploymentType": "Employment type",
  "@filtersEmploymentType": {
    "description": "One of section 5.5's nine filters. Multi-select."
  },
  "filtersWorkFormat": "Work format",
  "@filtersWorkFormat": {
    "description": "One of section 5.5's nine filters. Multi-select."
  },
  "filtersShift": "Shift",
  "@filtersShift": {
    "description": "One of section 5.5's nine filters. Multi-select."
  },
  "filtersSalaryFrom": "Pay from",
  "@filtersSalaryFrom": {
    "description": "The lower half of section 5.5's pay range. There is no upper half: the feed query has no parameter for it, and a control that does nothing to the list is worse than one that is absent."
  },
  "filtersSalaryNegotiableNote": "Vacancies with negotiable pay are still shown.",
  "@filtersSalaryNegotiableNote": {
    "description": "The server's rule, stated where somebody would otherwise conclude the filter is broken: a negotiable vacancy passes a pay floor because it has not said no to the figure, and excluding it would hide much of the seasonal work."
  },
  "filtersPublishedFrom": "Published from",
  "@filtersPublishedFrom": {
    "description": "Section 5.5's publication date. Matched on or after, and sent as `YYYY-MM-DD` — the server compares against the date it published in its own zone, so the client must not turn this into an instant."
  },
  "filtersUnavailableTitle": "Three filters are not available yet",
  "@filtersUnavailableTitle": {
    "description": "Says out loud what section 5.5 lists and the API cannot do, rather than leaving somebody hunting for a control that is not there. Removed the day the query parameters exist."
  },
  "filtersUnavailableBody": "Experience, language and an upper pay limit cannot be filtered on yet. Everything else here works.",
  "@filtersUnavailableBody": {
    "description": "Names the three rather than apologising generically, and says the rest works — otherwise a reader has no way to tell which of the controls above to trust."
  },
  "feedFilteredNote": "{count} filters applied",
  "@feedFilteredNote": {
    "description": "Shown above a filtered feed. A set of ids counts once however many it holds — three occupations is one narrowing decision, and a badge reading 5 for one row of chips tells nobody anything.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "feedFilteredEmpty": "No vacancies match these filters. Try widening them.",
  "@feedFilteredEmpty": {
    "description": "A filtered feed with no results is a different fact from an empty feed: one is fixed by changing the filters, the other by waiting for employers to publish. Telling somebody with four filters set that there are no vacancies would simply be false."
  },
  "feedSavedUnfiltered": "Saved vacancies are never filtered.",
  "@feedSavedUnfiltered": {
    "description": "Shown on the saved tab while filters are set. The other two feeds are the server choosing what to show; saved is a list the candidate curated, and a filter making a saved vacancy disappear from it reads as data loss rather than as narrowing."
  },
  "notesEmpty": "No notes yet.",
  "@notesEmpty": {
    "description": "An empty note list. Nothing to explain; nothing is wrong."
  },
  "notesNewLabel": "New note",
  "@notesNewLabel": {
    "description": "The API offers GET and POST and no edit or delete, so notes are append-only and the label says \"new\" rather than \"note\": a dated observation silently rewritten later is worse than two notes, because the first one is what the employer acted on."
  },
  "notesNewHint": "Asked for 8m, may take 6.5 — call back Thursday",
  "@notesNewHint": {
    "description": "A hint that shows what the field is *for*. A recruiter shown an empty box labelled \"note\" writes nothing; one shown this writes the thing they would have kept in their head."
  },
  "applicantsNoneAtStage": "Nobody is at this stage. Clear the filter to see every applicant.",
  "@applicantsNoneAtStage": {
    "description": "A stage with nobody in it is a different fact from a vacancy nobody applied to: one is fixed by clearing the filter, the other by waiting. Telling an employer looking at \"Hired\" that nobody has applied would be false."
  },
  "shortlistTitle": "Shortlist",
  "@shortlistTitle": {
    "description": "§7.3: one vacancy's shortlist, opened from that vacancy. A shortlist is always per-vacancy — an employer filling two roles keeps two."
  },
  "shortlistEmpty": "Nobody is shortlisted yet",
  "@shortlistEmpty": {
    "description": "Empty state. Deliberately not “you have shortlisted nobody”: BR-02 takes a candidate who hides their profile out of this list without anyone having removed them, exactly as it does the saved list."
  },
  "roleSelectionTitle": "How will you use JobBridge?",
  "@roleSelectionTitle": {
    "description": "§2.3: the screen an account with no role lands on. A question rather than “Choose your role”, because the answer is about what the person came to do."
  },
  "roleSelectionSubtitle": "Pick one or both — you can add the other later without a second account.",
  "@roleSelectionSubtitle": {
    "description": "§2.3 allows both roles on one account and makes the choice reversible, so the screen says so before somebody agonises over it."
  },
  "roleCandidateDescription": "Build a profile employers can find, apply to vacancies, and answer invitations.",
  "@roleCandidateDescription": {
    "description": "§2.2's candidate capabilities, in the order somebody meets them. Not a full list — the point is to make the word “Candidate” mean something to a first-time reader."
  },
  "roleEmployerDescription": "Publish vacancies, search candidates, and invite the people you want to talk to.",
  "@roleEmployerDescription": {
    "description": "§2.2's employer capabilities. Deliberately silent about Coins and unlocks: those are a cost, and a cost stated before anything is on offer reads as a paywall on registration."
  },
  "roleSelectionBoth": "With both, one account keeps two separate spaces: your own profile and your company's, switched from your profile.",
  "@roleSelectionBoth": {
    "description": "§2.3's “role-specific data and menus shall remain separated”. Shown because the fear that picking both mixes a personal job search into a company account is exactly what stops people picking both."
  },
  "chatListEmpty": "A conversation opens with a hiring interaction — an application, or an invitation that was accepted.",
  "@chatListEmpty": {
    "description": "§9.1's gate, stated as what fills the list rather than as what is missing. Deliberately role-neutral: one screen serves both sides, and picking the sentence by role would make this screen hold an opinion about §9.1 that the server already holds better."
  },
  "chatParticipantUnknown": "Participant",
  "@chatParticipantUnknown": {
    "description": "A thread whose counterpart has no name to show. §7.3's permitted-name rule means an absent name is sometimes the correct answer rather than a load that failed, so the row still reads as a person instead of as a gap."
  },
  "chatUnreadCount": "{count}",
  "@chatUnreadCount": {
    "description": "The unread pill's numeral. A message rather than a Dart format string so the thousands separator follows the interface variant; the pill's shape carries the meaning, so there is no word here.",
    "placeholders": {
      "count": {
        "type": "int",
        "format": "decimalPattern"
      }
    }
  },
  "chatUnreadSemantics": "{count, plural, one{{count} unread message} other{{count} unread messages}}",
  "@chatUnreadSemantics": {
    "description": "What a screen reader says for the unread pill. The pill itself is a numeral, and a reader hearing only \"3\" would not know three of what.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "chatNoMessages": "No messages yet",
  "@chatNoMessages": {
    "description": "The preview line of a thread that was opened and never written in. A real state: opening a conversation and sending one are two requests, and somebody can do the first and change their mind."
  },
  "chatAttachment": "Attachment",
  "@chatAttachment": {
    "description": "The preview line when the last message carried a file and no text. Three cases, not two: the server sends the last message's body, and a message with only an attachment has none — which is not the same fact as a thread nobody has written in."
  },
  "chatReadOnly": "Read-only",
  "@chatReadOnly": {
    "description": "Badge on a thread whose hiring interaction has ended (§9.1). The word says what the reader can still do, not what they cannot: the history stays readable on purpose."
  },
  "chatBlocked": "Blocked",
  "@chatBlocked": {
    "description": "Badge on a thread the other side blocked. A separate word from read-only because it is undone by a different thing."
  },
  "chatBlockedByYou": "You blocked this",
  "@chatBlockedByYou": {
    "description": "Badge on a thread the reader blocked themselves. Same state, different sentence: only the person who set a block can lift it, so telling the two apart on the row is what makes the thread's own screen unsurprising."
  },
  "chatReadOnlyTitle": "This conversation is history",
  "@chatReadOnlyTitle": {
    "description": "§9.1: the interaction ended, so the thread no longer accepts messages. Not \"closed\" — closed reads as gone, and the messages are still here."
  },
  "chatReadOnlyBody": "The application or invitation it came from has ended, so no new messages can be sent. Everything already here stays readable.",
  "@chatReadOnlyBody": {
    "description": "Names the cause, because the remedy is not on this screen: what reopens the thread is the hiring interaction resuming, and somebody looking for a button needs to know there is not one."
  },
  "chatBlockedTitle": "Blocked",
  "@chatBlockedTitle": {
    "description": "Notice heading on a thread the other side blocked."
  },
  "chatBlockedBody": "The other person blocked this conversation. Nobody can send here while that stands, and the messages stay readable.",
  "@chatBlockedBody": {
    "description": "Says that it applies to both sides, because §9.1 makes a block symmetrical whoever set it — and deliberately offers no action: this block is not the reader's to lift."
  },
  "chatBlockedByYouTitle": "You blocked this conversation",
  "@chatBlockedByYouTitle": {
    "description": "Notice heading on a thread the reader blocked."
  },
  "chatBlockedByYouBody": "Neither side can send while the block stands — including you. Unblock from the top of the screen to write again.",
  "@chatBlockedByYouBody": {
    "description": "\"Including you\" is the part worth saying: somebody reaching for a block often wants a mute, and §9.1 does not have one. It also names where the control is, since the notice deliberately does not carry it — a condition and the thing that clears it are two taps apart everywhere else in this app."
  },
  "chatUnblock": "Unblock",
  "@chatUnblock": {
    "description": "Lifts the reader's own block. Offered only where they set it: the route cannot lift the other side's, and a control that looks like it can would be worse than none."
  },
  "chatUnblocked": "Unblocked. You can write again.",
  "@chatUnblocked": {
    "description": "Confirms the block was lifted, and says what changed as a result — \"unblocked\" alone leaves somebody looking for the composer to find out."
  },
  "chatBlockAction": "Block",
  "@chatBlockAction": {
    "description": "Opens the block sheet, and the verb on its confirm button."
  },
  "chatBlockTitle": "Block this conversation?",
  "@chatBlockTitle": {
    "description": "The block sheet's heading."
  },
  "chatBlockBody": "It becomes read-only for both of you — you will not be able to send either. The messages stay readable, and a moderator can review them.",
  "@chatBlockBody": {
    "description": "States the consequence before the button rather than asking \"are you sure?\". §9.1's block is symmetrical, and somebody reaching for it is often reaching for a mute — so the sheet says which one this is while there is still time to back out."
  },
  "chatBlockReasonLabel": "Reason (optional)",
  "@chatBlockReasonLabel": {
    "description": "Marked optional in the label. It is for the moderator who may review the thread, and requiring a justification from somebody blocking for their own safety gets the wrong answer typed in."
  },
  "chatBlockReasonHint": "For the moderator who reviews this",
  "@chatBlockReasonHint": {
    "description": "Says who reads it, which is the only thing that makes writing one worthwhile."
  },
  "chatReportTitle": "Report this message",
  "@chatReportTitle": {
    "description": "§9.1's report, filed into the same complaint queue M10 reviews vacancy reports through."
  },
  "chatReportBody": "A moderator reads the report and decides. Blocking the conversation is separate, and you can do both.",
  "@chatReportBody": {
    "description": "Sets the expectation that nothing changes on this screen — a report is filed, not applied — and points at the block, because somebody reporting harassment usually wants the messages to stop as well and would otherwise assume reporting did that."
  },
  "chatReportReasonLabel": "What is wrong with it",
  "@chatReportReasonLabel": {
    "description": "Free text and required. Free because somebody objecting to a message should not have to find their objection on a list; required because the complaint lands in a queue as a row a moderator has to be able to act on."
  },
  "chatReportReasonHint": "Asked me to pay for the job",
  "@chatReportReasonHint": {
    "description": "A hint that shows what the field is for by naming a real thing that happens on job platforms. Somebody shown an empty box labelled \"reason\" writes nothing; somebody shown this writes what actually happened."
  },
  "chatReportSubmit": "Send report",
  "@chatReportSubmit": {
    "description": "The verb on the confirm button, never \"OK\"."
  },
  "chatReportDone": "Report sent. A moderator will review it.",
  "@chatReportDone": {
    "description": "Confirms the filing and says what happens next, since nothing visible changes: the message stays where it was and the thread stays open, because §9.1 gives the outcome to a moderator rather than to the reporter."
  },
  "chatComposerLabel": "Message",
  "@chatComposerLabel": {
    "description": "The composer's persistent label — every control in this design carries one."
  },
  "chatComposerHint": "Write a message",
  "@chatComposerHint": {
    "description": "The composer's placeholder."
  },
  "chatSend": "Send",
  "@chatSend": {
    "description": "Sends the message. Inert only while there is nothing to send — never because of a rule about whether this person may chat, which is the server's to apply."
  },
  "chatSendRefusedTitle": "Not sent",
  "@chatSendRefusedTitle": {
    "description": "Heading over the server's own refusal, beside the composer that failed. The sentence underneath is the server's, so there is exactly one wording of each refusal — and the draft is deliberately kept, because somebody who wrote three paragraphs into a thread that closed under them must be able to copy them out."
  },
  "chatSent": "Sent",
  "@chatSent": {
    "description": "On an outgoing message the other side has not read yet. §9.1 asks for sent / delivered / read and the server sends two of the three: delivery belongs to push (M9), and a flag written in the same statement as the timestamp would be a fabricated answer — so there is no middle state here."
  },
  "chatRead": "Read",
  "@chatRead": {
    "description": "On an outgoing message the other side has read. Shown on outgoing messages only: on an incoming one the same field answers whether the reader has read it, which they can see for themselves."
  },
  "chatEarlier": "Earlier messages",
  "@chatEarlier": {
    "description": "Fetches the page before the oldest message loaded. A control rather than an infinite scroll, so somebody on a metered connection decides when to spend the request."
  },
  "chatThreadEmpty": "No messages yet. Write the first one.",
  "@chatThreadEmpty": {
    "description": "An open thread with nothing in it — the state right after somebody opened the conversation from a candidate profile."
  },
  "chatThreadEmptyClosed": "No messages were sent before this conversation closed.",
  "@chatThreadEmptyClosed": {
    "description": "The same emptiness on a thread that can no longer take messages. A different fact and a different sentence: inviting somebody to write the first message where the composer is gone would be an instruction they cannot follow."
  },
  "chatOpenAction": "Send a message",
  "@chatOpenAction": {
    "description": "§9.1's entry point, in the contact block of §7.3's candidate profile — the same entitlement that reveals a phone number is the one that opens chat, from the same service on the server. It sits beside copy rather than replacing it: a message needs the other person to open the app, and a phone number does not."
  },
  "interviewTitle": "Interview",
  "@interviewTitle": {
    "description": "§8.3's object, used as the fallback word for an interview type this build does not recognise. A newer server's fourth type still has a time and a status worth rendering, so the card says what the thing is rather than guessing which detail field to look for."
  },
  "interviewStatusScheduled": "Scheduled",
  "@interviewStatusScheduled": {
    "description": "§8.3: a time has been set and the candidate has not answered. Warning-toned because the tone means \"waiting on a person\", and that person is whoever is reading it."
  },
  "interviewStatusConfirmed": "Confirmed",
  "@interviewStatusConfirmed": {
    "description": "The candidate agreed to the time. Deliberately not an ending: §8.3 lets somebody who confirmed and then found a clash ask for another time, so the word is a good outcome rather than a closed door."
  },
  "interviewStatusRescheduleRequested": "Another time asked",
  "@interviewStatusRescheduleRequested": {
    "description": "The candidate asked for a different time, so it waits on the employer. Kept short because it shares a row with a full date at 320pt: \"Another time requested\" does not fit and a badge must never be the thing that truncates."
  },
  "interviewStatusCancelled": "Cancelled",
  "@interviewStatusCancelled": {
    "description": "The employer called it off — §8.3's only ending. Neutral rather than red: a cancelled interview is not a rejected application, and the application carries its own stage."
  },
  "interviewTypePhone": "Phone call",
  "@interviewTypePhone": {
    "description": "§8.3's phone interview. The only type with no detail field of its own, which is why the word matters: without it the card would show a time and nothing else."
  },
  "interviewTypeInPerson": "In person",
  "@interviewTypeInPerson": {
    "description": "§8.3's in-person interview. Carries an address, which the server requires for this type and forbids for the others."
  },
  "interviewTypeExternalLink": "Video link",
  "@interviewTypeExternalLink": {
    "description": "§8.3's external-link interview. \"Video link\" rather than \"online\": §2.4 puts a built-in video engine out of scope, so this is somebody else's meeting URL and the word should not imply the app hosts it."
  },
  "interviewPhoneNote": "The employer will call the number on your profile.",
  "@interviewPhoneNote": {
    "description": "Shown on a phone interview because it is the one type with nothing else to show. It also answers the question it raises: BR-01 already verified the number, which is exactly why the employer was never asked to retype it."
  },
  "interviewWhere": "Where",
  "@interviewWhere": {
    "description": "Label above an in-person interview's address."
  },
  "interviewLink": "Link",
  "@interviewLink": {
    "description": "Label above an external-link interview's URL. Copyable rather than tappable: opening it needs url_launcher, and pubspec.yaml's version bounds are load-bearing — the browser takes it from the clipboard, exactly as the dialler takes a phone number."
  },
  "interviewInstructions": "From the employer",
  "@interviewInstructions": {
    "description": "Label above §8.3's \"documents or preparation notes\". Named for whose words they are, because they are never translated (§2.4) and \"bring your diploma\" is the sentence that must survive whole."
  },
  "interviewYourReply": "Your reply",
  "@interviewYourReply": {
    "description": "Label above the note the candidate sent with their answer, played back to them."
  },
  "interviewPassed": "This time has already passed.",
  "@interviewPassed": {
    "description": "Said rather than hidden: an interview whose time has gone by is still the record of what was arranged, and somebody who missed one needs to see that they did. The actions stay on offer, because the server still accepts them and refusing here would be the client deciding on the employer's behalf that it is too late."
  },
  "interviewCancelledNotice": "The employer called this interview off.",
  "@interviewCancelledNotice": {
    "description": "Names who did it, because §8.3 gives cancelling to the employer alone and a candidate reading \"cancelled\" would otherwise wonder whether they had done it themselves."
  },
  "interviewConfirm": "Confirm",
  "@interviewConfirm": {
    "description": "§8.3's first candidate response. The filled button where it is offered, because it is the answer that lets the interview happen."
  },
  "interviewRequestAnother": "Ask for another time",
  "@interviewRequestAnother": {
    "description": "§8.3's second candidate response. A real alternative rather than a lesser one, so it is a secondary button and never hidden — a candidate who cannot make the time must not have to hunt for the way to say so."
  },
  "interviewConfirmTitle": "Confirm this time?",
  "@interviewConfirmTitle": {
    "description": "The confirm sheet's heading. A question, not \"Are you sure?\" — and no warning about finality, because confirming is not final: §8.3 lets a candidate who confirms and then finds a clash ask for another time."
  },
  "interviewConfirmBody": "The employer will see that the time suits you. If something changes later you can still ask for another time.",
  "@interviewConfirmBody": {
    "description": "Says what the employer will see, which is the part the candidate is actually deciding about, and then removes the fear that stops people confirming: the answer is changeable."
  },
  "interviewRescheduleTitle": "Ask for another time",
  "@interviewRescheduleTitle": {
    "description": "The reschedule sheet's heading, the same words as the button that opened it."
  },
  "interviewRescheduleBody": "The interview stays booked until the employer sets a new time, and they will see what you write below.",
  "@interviewRescheduleBody": {
    "description": "Sets the expectation that asking does not cancel anything — a candidate who thinks it does will not ask, and will miss the interview instead."
  },
  "interviewNoteLabel": "Which times suit you",
  "@interviewNoteLabel": {
    "description": "Required, though the server takes it as optional. \"The candidate wants another time\" with no time attached is a message the employer cannot act on, so the interview stalls while each side waits for the other. Same judgement as the invitation sheet's \"Request details\"."
  },
  "interviewNoteHint": "Any afternoon this week, or Friday morning",
  "@interviewNoteHint": {
    "description": "A hint that shows what the field is for. Somebody shown an empty box writes \"I can't make it\"; somebody shown this writes something the employer can book."
  },
  "interviewReplyNoteLabel": "Note (optional)",
  "@interviewReplyNoteLabel": {
    "description": "Marked optional in the label, because a confirmation owes no explanation and asking for one implies it does."
  },
  "interviewReplyNoteHint": "I will be there ten minutes early",
  "@interviewReplyNoteHint": {
    "description": "Shows the field is for a courtesy rather than a justification."
  },
  "interviewNotAllowed": "This interview has moved on",
  "@interviewNotAllowed": {
    "description": "Heading over the server's refusal when the answer no longer applies — `interview.final` after a cancellation, or `interview.response_not_allowed` for saying the same thing twice. Both mean somebody moved first, which is a sentence that belongs beside the button that failed rather than in a toast four seconds later."
  },
  "interviewSchedule": "Schedule an interview",
  "@interviewSchedule": {
    "description": "§8.3's employer action, on an applicant row. Offered independently of §8.1's stage: the interview and the stage are separate records, so neither drives the other — scheduling one is usually what happens *before* moving somebody to the interview stage."
  },
  "interviewScheduleTitle": "Schedule an interview",
  "@interviewScheduleTitle": {
    "description": "The scheduling sheet's heading."
  },
  "interviewScheduleSave": "Send to the candidate",
  "@interviewScheduleSave": {
    "description": "The verb on the confirm button, named for what actually happens: the candidate sees the interview and is asked to confirm. \"Save\" would suggest a draft, and §8.3 has none."
  },
  "interviewRescheduleFormTitle": "Move this interview",
  "@interviewRescheduleFormTitle": {
    "description": "The same form, reached from an existing interview. \"Move\" rather than \"edit\", because the field that matters is the time and the candidate has to answer again."
  },
  "interviewRescheduleSave": "Save the new time",
  "@interviewRescheduleSave": {
    "description": "The verb on the confirm button when rescheduling."
  },
  "interviewRescheduleResets": "The candidate will be asked to confirm again, even for a small change — an interview moved to another time has not been confirmed.",
  "@interviewRescheduleResets": {
    "description": "The server resets the status to `scheduled` on every edit, and it is right to: a confirmation belongs to the time it was given for. But an employer nudging the time by ten minutes needs to know it costs them a confirmation, or they will do it and wonder why the badge changed."
  },
  "interviewTypeLabel": "Kind of interview",
  "@interviewTypeLabel": {
    "description": "Label above the three type options. Radio rows rather than a segmented control: three segments at 360pt give each about 110pt, and \"Личная встреча\" does not fit that on one line — the same measurement that kept §8.2's status filters off HhSegmented."
  },
  "interviewWhereHint": "Amir Temur 12, 3rd floor — ask for Dilnoza at reception",
  "@interviewWhereHint": {
    "description": "A hint that shows what the field is *for*: an address alone leaves a candidate standing in a lobby. Required for an in-person interview and forbidden for the other two, which the server enforces both ways."
  },
  "interviewLinkHint": "https://meet.example.com/abc-defg-hij",
  "@interviewLinkHint": {
    "description": "Somebody else's meeting URL — §2.4 puts a built-in video engine out of scope. Required for a video-link interview and forbidden for the other two."
  },
  "interviewDateLabel": "Date",
  "@interviewDateLabel": {
    "description": "Label on the date picker. ISO on the wire, because §8.3's display policy for dates is still open and a format invented here would have to be undone."
  },
  "interviewTimeLabel": "Time",
  "@interviewTimeLabel": {
    "description": "Label on the time picker. The picked time means the **platform's** clock, which is the clock the candidate's card renders — the only reading on which the two sides agree."
  },
  "interviewTimeHint": "10:00",
  "@interviewTimeHint": {
    "description": "Twenty-four hour, as everywhere else in the app: none of the four interface variants uses an am/pm convention."
  },
  "interviewInstructionsLabel": "Anything they should bring or prepare",
  "@interviewInstructionsLabel": {
    "description": "§8.3's \"documents or preparation notes\", labelled as the question it answers rather than as the field name. Optional, and shown to the candidate in the employer's own words — never translated (§2.4)."
  },
  "interviewInstructionsHint": "Bring your diploma and your work record book",
  "@interviewInstructionsHint": {
    "description": "The example that makes the field obvious. An employer shown an empty box labelled \"instructions\" writes nothing."
  },
  "interviewReschedule": "Move",
  "@interviewReschedule": {
    "description": "Opens the form on an existing interview. Absent on a cancelled one: §8.3's only ending is cancellation, and rescheduling one would be reviving it — which the server refuses with `interview.final`."
  },
  "interviewCancelAction": "Call it off",
  "@interviewCancelAction": {
    "description": "§8.3's employer-only ending, and the verb on the confirm button. Not \"cancel\", which is also the word on the button that closes the sheet without doing anything."
  },
  "interviewCancelTitle": "Call off this interview?",
  "@interviewCancelTitle": {
    "description": "The cancellation sheet's heading."
  },
  "interviewCancelBody": "This is final for both sides — the interview cannot be brought back, and a new time means scheduling a new one. The candidate will see that it was called off.",
  "@interviewCancelBody": {
    "description": "Names the consequence rather than asking \"are you sure?\". Cancelling is §8.3's only ending and nothing undoes it, so the sheet says both halves of that: it is final, and a replacement is a new record."
  },
  "interviewCancelReasonLabel": "Reason (optional, the candidate sees it)",
  "@interviewCancelReasonLabel": {
    "description": "The parenthesis is the load-bearing part. The reason is shown to the candidate, and an employer writing \"found someone closer\" for their own records would be writing it to the person it is about."
  },
  "interviewCancelReasonHint": "The role has been filled — thank you for your time",
  "@interviewCancelReasonHint": {
    "description": "Shows the field is addressed to the candidate, by giving an example somebody would be willing to read."
  },
  "interviewCandidateReply": "What the candidate said",
  "@interviewCandidateReply": {
    "description": "Label above the note the candidate sent with their answer, on the employer's side. Their own words (§2.4) — and the point of the whole feature, because \"another time please\" is useless without the times."
  },
  "commonShowMore": "Show more",
  "@commonShowMore": {
    "description": "Loads the next page of a list. Shared: paging reads the same on a Coin ledger and on a moderation queue, and a second copy of \"Show more\" is a second thing to translate."
  },
  "commonLoadingMore": "Loading more…",
  "@commonLoadingMore": {
    "description": "Footer spinner label while the next page is in flight. Keeps the loaded rows visible, which a full-screen loader would not."
  },
  "adminDashboardTitle": "Administration",
  "@adminDashboardTitle": {
    "description": "§10.1's heading. In the body rather than an app bar, because a shell tab has none."
  },
  "adminQueuesTitle": "Waiting on a decision",
  "@adminQueuesTitle": {
    "description": "Heading over the three current-state queue counters. Deliberately not \"Statistics\": these are work items, and they come before the period figures because a queue is something to act on."
  },
  "adminAwaitingVerification": "Employers awaiting verification",
  "@adminAwaitingVerification": {
    "description": "§10.1's \"profiles awaiting verification\". Says employers, because §6.1 is the only verification in the product and \"profiles\" reads as candidates."
  },
  "adminAwaitingModeration": "Vacancies awaiting moderation",
  "@adminAwaitingModeration": {
    "description": "§10.1's \"vacancies awaiting moderation\" (BR-04)."
  },
  "adminOpenComplaints": "Open complaints",
  "@adminOpenComplaints": {
    "description": "§10.1's open complaints, counted as current state like the other two queues."
  },
  "adminQueuesClear": "Nothing is waiting on you.",
  "@adminQueuesClear": {
    "description": "All three queues are empty. Said as a sentence rather than three zeros, because three zeros read as a screen that failed to load."
  },
  "adminSanctionsTitle": "Accounts under sanction",
  "@adminSanctionsTitle": {
    "description": "Heading over the restricted and blocked counts. Named for what they are rather than \"Users\", which is the tab next door."
  },
  "adminRestrictedUsers": "Restricted",
  "@adminRestrictedUsers": {
    "description": "§4.2 restriction: the account still signs in, individual actions are gated. Counted apart from blocked because the remedies differ."
  },
  "adminBlockedUsers": "Blocked",
  "@adminBlockedUsers": {
    "description": "BR-10's shut-out. Never added to the restricted count: that would hide the more serious state inside the milder one."
  },
  "adminPeriodTitle": "For the selected period",
  "@adminPeriodTitle": {
    "description": "Heading over §10.1's period-bounded figures. The heading is what keeps them from being read as current state."
  },
  "adminPeriodDays": "{days, plural, one{{days} day} other{{days} days}}",
  "@adminPeriodDays": {
    "description": "A period preset, e.g. \"30 days\". Uzbek does not inflect, so it carries only the `other` branch, as elsewhere.",
    "placeholders": {
      "days": {
        "type": "int"
      }
    }
  },
  "adminCandidates": "Candidates",
  "@adminCandidates": {
    "description": "§10.1's candidate counts. Its own key rather than the nav label, which carries a soft hyphen for the 70pt bar and would break mid-word here."
  },
  "adminEmployers": "Employers",
  "@adminEmployers": {
    "description": "§10.1's employer counts."
  },
  "adminVacanciesPublished": "Vacancies published",
  "@adminVacanciesPublished": {
    "description": "Vacancies published inside the period. \"Published\", not \"active\": the figure is period-bounded, and a vacancy live today may have been published before it."
  },
  "adminApplicationsSubmitted": "Applications submitted",
  "@adminApplicationsSubmitted": {
    "description": "Applications submitted inside the period."
  },
  "adminCountTotal": "in total",
  "@adminCountTotal": {
    "description": "Suffix under the total of a §10.1 count pair."
  },
  "adminCountNew": "new",
  "@adminCountNew": {
    "description": "Suffix under the newly-registered half of a §10.1 count pair."
  },
  "adminVerificationTitle": "Employer verification",
  "@adminVerificationTitle": {
    "description": "§10.2's employer verification queue."
  },
  "adminVerificationFifo": "Oldest first — the submission at the top has waited longest.",
  "@adminVerificationFifo": {
    "description": "Says the ordering out loud, because it is what makes the queue fair and it is not visible from a list of names."
  },
  "adminVerificationEmpty": "Nobody is waiting",
  "@adminVerificationEmpty": {
    "description": "Empty queue. A good state, so it is not phrased as an absence of results."
  },
  "adminVerificationEmptyBody": "Submissions appear here as employers send their documents in.",
  "@adminVerificationEmptyBody": {
    "description": "Explains how the list fills up rather than restating that it is empty, which is the rule for every empty state in the design."
  },
  "adminEmployerCompany": "Company",
  "@adminEmployerCompany": {
    "description": "§6.1 company employer, as a label on a review card. Its own key rather than employerTypeCompany, which is phrased as a first-person choice (\"A company\") for the chooser."
  },
  "adminEmployerIndividual": "Individual employer",
  "@adminEmployerIndividual": {
    "description": "§6.1 individual employer, as a label on a review card."
  },
  "adminEmployerUnnamed": "No name on file",
  "@adminEmployerUnnamed": {
    "description": "Neither a legal nor a public name has been filled in. A real state: a profile can be complete enough for the server to accept a submission and still be thin on screen. Stated rather than left blank, so the card is not read as broken."
  },
  "adminWaitingDays": "{days, plural, =0{Submitted today} one{Waiting {days} day} other{Waiting {days} days}}",
  "@adminWaitingDays": {
    "description": "How long this submission has waited — the actionable fact about a FIFO queue, which a submission date alone does not give. Zero has its own branch because \"waiting 0 days\" reads as a bug.",
    "placeholders": {
      "days": {
        "type": "int"
      }
    }
  },
  "adminEvidenceTitle": "Evidence",
  "@adminEvidenceTitle": {
    "description": "§10.2's uploaded evidence."
  },
  "adminEvidenceNone": "No documents attached",
  "@adminEvidenceNone": {
    "description": "A submission with no files. Possible: the server refuses one missing a *required* document, not one missing an optional one."
  },
  "adminVerify": "Verify",
  "@adminVerify": {
    "description": "§10.2's approval. The verb, not \"Approve\", because §6.1 calls the resulting state verified and the badge the employer sees says the same word."
  },
  "adminRequestChanges": "Ask for changes",
  "@adminRequestChanges": {
    "description": "§10.2's \"request changes\" — the outcome the employer can act on, which is why it sits between approval and rejection rather than beside rejection."
  },
  "adminReject": "Reject",
  "@adminReject": {
    "description": "§10.2's refusal."
  },
  "adminVerifyTitle": "Verify this employer?",
  "@adminVerifyTitle": {
    "description": "Confirmation heading for an approval."
  },
  "adminVerifyBody": "This is what lets them publish vacancies and invite candidates. Nothing else about their account changes.",
  "@adminVerifyBody": {
    "description": "Names the consequence rather than asking \"are you sure?\". BR-03 is one gate over two features, so both are said: an administrator approving a submission is unblocking vacancies *and* invitations at once."
  },
  "adminRequestChangesTitle": "Send this back for changes?",
  "@adminRequestChangesTitle": {
    "description": "Confirmation heading for sending a submission back."
  },
  "adminRequestChangesBody": "They keep their profile and their files, and can submit again once they have fixed what you name below.",
  "@adminRequestChangesBody": {
    "description": "Says what survives, because the difference between this outcome and rejection is exactly that the employer can act on it."
  },
  "adminRejectTitle": "Reject this submission?",
  "@adminRejectTitle": {
    "description": "Confirmation heading for a refusal."
  },
  "adminRejectBody": "They stay unverified and cannot publish or invite. Your reason is all they are given, so write what it would take to pass.",
  "@adminRejectBody": {
    "description": "The reason is the whole of what the employer is left with (§6.1 shows it verbatim), so the sheet says that before the field rather than after the refusal."
  },
  "adminReasonLabel": "Reason (the employer reads it word for word)",
  "@adminReasonLabel": {
    "description": "The parenthesis is the load-bearing part: §6.1 shows this text to the employer verbatim (§2.4), so an administrator writing a note for their own records would be writing it to the person it is about."
  },
  "adminWalletsTitle": "Wallets",
  "@adminWalletsTitle": {
    "description": "§10.5. Entry point sits on the users tab, since a wallet belongs to an employer."
  },
  "adminWalletsOrder": "Largest balance first.",
  "@adminWalletsOrder": {
    "description": "Says why the list is in the order it is, so nobody looks for a sort control. Largest balance first is the server's order and is where both the money and the risk are."
  },
  "adminWalletsEmpty": "No wallets yet",
  "@adminWalletsEmpty": {
    "description": "Empty state heading for the wallet list."
  },
  "adminWalletsEmptyBody": "A wallet is created when someone first registers as an employer.",
  "@adminWalletsEmptyBody": {
    "description": "BR-15 creates a wallet at first employer registration, so an empty list means no employer has registered rather than a fault."
  },
  "adminWalletUnnamed": "Account erased",
  "@adminWalletUnnamed": {
    "description": "BR-14 erases the person and keeps the id, because §6.7 keeps payment records for reconciliation and BR-24 forbids rewriting the ledger. So a wallet can outlive the employer behind it, and the absence is stated rather than left blank."
  },
  "adminWalletUnlocks": "{count, plural, one{{count} unlock} other{{count} unlocks}}",
  "@adminWalletUnlocks": {
    "description": "How many candidates this employer has unlocked (BR-16).",
    "placeholders": {
      "count": {"type":"int"}
    }
  },
  "adminWalletBonusOn": "Registration bonus {date}",
  "@adminWalletBonusOn": {
    "description": "When BR-15's ten Coins were granted. Shown rather than derived from the ledger: \"exactly once\" is the rule, and a missing date is what a failed grant looks like.",
    "placeholders": {
      "date": {"type":"String"}
    }
  },
  "adminWalletNoBonus": "No registration bonus",
  "@adminWalletNoBonus": {
    "description": "A wallet that never received BR-15's bonus. Worth saying, because the absence is the diagnostic part."
  },
  "adminWalletTitle": "Wallet",
  "@adminWalletTitle": {
    "description": "Title of one employer wallet (§10.5)."
  },
  "adminWalletGone": "This account has no wallet",
  "@adminWalletGone": {
    "description": "A 404 on a wallet: BR-15 creates one at first employer registration, so a user who never became an employer has none. An outcome, not a fault."
  },
  "adminWalletGoneBody": "A wallet exists only once someone has registered as an employer.",
  "@adminWalletGoneBody": {
    "description": "Explains the 404 above."
  },
  "adminWalletLedger": "Transaction history",
  "@adminWalletLedger": {
    "description": "Heading above the transaction list."
  },
  "adminWalletImmutable": "This history cannot be edited or deleted. A correction is a new entry.",
  "@adminWalletImmutable": {
    "description": "BR-24, said on screen. Three database triggers refuse UPDATE, DELETE and TRUNCATE on the ledger — so an administrator looking at a mistaken adjustment does not go hunting for a way to remove it."
  },
  "adminWalletNoTransactions": "Nothing has moved yet",
  "@adminWalletNoTransactions": {
    "description": "A wallet whose ledger is empty."
  },
  "adminAdjustAction": "Adjust balance",
  "@adminAdjustAction": {
    "description": "Opens the adjustment sheet."
  },
  "adminAdjustAmount": "Coins (use a minus to take Coins away)",
  "@adminAdjustAmount": {
    "description": "Signed Coin amount for an adjustment. Negative takes Coins away."
  },
  "adminAdjustAmountHint": "5, or -3",
  "@adminAdjustAmountHint": {
    "description": "Placeholder showing both directions."
  },
  "adminAdjustReason": "Reason (recorded in the audit log)",
  "@adminAdjustReason": {
    "description": "Mandatory, and checked by the database as well as the DTO (§10.5). Distinct from adminReasonLabel, which is read by the employer — this one is read by whoever audits the adjustment."
  },
  "adminAdjustReasonHint": "Refund for a failed top-up, order 4821",
  "@adminAdjustReasonHint": {
    "description": "An example of a real reason for an adjustment."
  },
  "adminAdjustNote": "This adds a new entry to the ledger under your name. It cannot be undone — correcting it means making another adjustment.",
  "@adminAdjustNote": {
    "description": "BR-24 stated before the action rather than discovered after it: the entry is permanent and is attributed to the administrator making it."
  },
  "adminAdjustSubmit": "Adjust",
  "@adminAdjustSubmit": {
    "description": "Confirms the adjustment."
  },
  "adminAdjustZero": "Enter a number other than zero.",
  "@adminAdjustZero": {
    "description": "The server refuses zero: an entry that changes nothing is a ledger row with no meaning. Said before the request rather than as a 422 after it."
  },
  "adminAdjustDone": "Adjusted. The balance is now {balance}.",
  "@adminAdjustDone": {
    "description": "Confirmation after an adjustment, naming the new balance so the administrator does not have to look for it.",
    "placeholders": {
      "balance": {"type":"int"}
    }
  },
  "adminPaymentsPending": "Payment order search is not available yet",
  "@adminPaymentsPending": {
    "description": "§10.5 also asks for Payment Order search on six axes. The API has payment endpoints, but they answer only for the employer making the request — there is no administrator route. Stated on the screen rather than left as a missing feature, the same way §10.3 states what label editing is waiting on."
  },
  "adminPaymentsPendingBody": "The server has no administrator route for payment orders yet — today it answers only for the employer making the request. Top-up itself is also not live.",
  "@adminPaymentsPendingBody": {
    "description": "Says what is missing and that it is known, so nobody reports it as a bug."
  },
  "adminPricingTitle": "Prices and the registration bonus",
  "@adminPricingTitle": {
    "description": "§10.5 names the registration bonus, the Coin price and the unlock price as server configuration."
  },
  "adminPricingBody": "These are set on the server. A change applies to future transactions only and never rewrites what the ledger already recorded.",
  "@adminPricingBody": {
    "description": "The half of §10.5 that is a *rule* rather than a screen: a price change applies to future transactions only and never rewrites the ledger. Said here because the natural reading of \"change the price\" is that history follows. Editing them needs a server route that does not exist yet."
  },
  "adminReasonHint": "The registration certificate is unreadable — please upload a clearer scan",
  "@adminReasonHint": {
    "description": "An example that shows the field is addressed to the employer and has to be actionable. An administrator shown an empty box labelled \"reason\" writes one word."
  },
  "adminAlreadyDecided": "Already decided",
  "@adminAlreadyDecided": {
    "description": "Title on the notice for a 409 employer.verification_not_pending. Not an error: two administrators working one FIFO queue produce this normally, and the queue is reloaded rather than a retry offered."
  },
  "adminDecisionRecorded": "Decision recorded.",
  "@adminDecisionRecorded": {
    "description": "Confirms the decision landed. §10.4 makes every administrator action an audit row, so \"recorded\" is literal rather than reassurance."
  },
  "adminQueueTitle": "Moderation",
  "@adminQueueTitle": {
    "description": "Heading over §10.2's two queues. The nav label is \"Moderatsiya\" and this repeats it deliberately: a shell tab has no app bar, so without it the segmented control is the only thing naming the screen."
  },
  "adminQueueEmployers": "Employers",
  "@adminQueueEmployers": {
    "description": "First segment: §10.2's employer verification queue. Named for the object rather than the action, so it reads beside the second segment."
  },
  "adminQueueVacancies": "Vacancies",
  "@adminQueueVacancies": {
    "description": "Second segment: the vacancy moderation queue (BR-04)."
  },
  "adminModerationEmpty": "No vacancy is waiting",
  "@adminModerationEmpty": {
    "description": "Empty moderation queue. A good state, so not phrased as an absence of results."
  },
  "adminModerationEmptyBody": "Vacancies appear here as employers submit them for publication.",
  "@adminModerationEmptyBody": {
    "description": "Explains how the list fills up rather than restating that it is empty."
  },
  "adminRestrictionFlag": "Age or gender limit",
  "@adminRestrictionFlag": {
    "description": "Badge on a queue row whose vacancy carries a BR-12 age or gender restriction. Warning-toned, and it is not an accusation: the tone means \"waiting on a person\", and a restriction is exactly what §10.2 will not let through unreviewed."
  },
  "adminReviewTitle": "Review",
  "@adminReviewTitle": {
    "description": "App-bar title on §10.2's vacancy review. Generic, because the vacancy's own title is the heading in the body and an employer's words do not belong in a chrome bar where they would be truncated."
  },
  "adminVacancyGoneTitle": "This vacancy has left the queue",
  "@adminVacancyGoneTitle": {
    "description": "The review answered 404. Most often a colleague decided it first, so this is an outcome and not a fault — its own notice, a way back, and no retry, the same treatment UAT-15 gives the candidate detail screen."
  },
  "adminVacancyGoneBody": "Somebody may have decided it already, or the employer may have withdrawn it.",
  "@adminVacancyGoneBody": {
    "description": "Names the likely reason without claiming to know which: the route answers 404 for decided, withdrawn and deleted alike."
  },
  "adminPublish": "Publish",
  "@adminPublish": {
    "description": "§10.2's approval, named for what it does. BR-04 makes approving the act that publishes, so \"Approve\" would understate it — there is no approve-without-publishing."
  },
  "adminSendBack": "Send back",
  "@adminSendBack": {
    "description": "§10.2's rejection. \"Send back\" rather than \"Reject\", because §6.4 returns an edited rejection to draft — it is a correction path, not an ending."
  },
  "adminPublishTitle": "Publish this vacancy?",
  "@adminPublishTitle": {
    "description": "Confirmation heading for publishing a vacancy."
  },
  "adminPublishBody": "Candidates see it straight away. If it carries an age or gender limit, publishing approves that limit too — this queue is the only way one can ever go live.",
  "@adminPublishBody": {
    "description": "Two consequences, and the second is the one a moderator can miss: for a BR-12 restricted vacancy this queue is the only route to publication, so approving the vacancy is approving the restriction with it."
  },
  "adminSendBackTitle": "Send this vacancy back?",
  "@adminSendBackTitle": {
    "description": "Confirmation heading for returning a vacancy to the employer."
  },
  "adminSendBackBody": "The employer can edit it and submit again. Your reason is the only guidance they get, so name what has to change.",
  "@adminSendBackBody": {
    "description": "Says what survives and what the reason is for: §6.4 puts an edited rejection back in draft, so the reason is an instruction rather than a verdict."
  },
  "adminRestrictionJudge": "A limit is only allowed where the reason genuinely requires it. Judge the reason, not the limit.",
  "@adminRestrictionJudge": {
    "description": "The BR-12 question, stated as a question rather than as a warning: §10.2 asks a person to decide whether the stated reason genuinely requires the limit. Without this the card is four labels and no task."
  },
  "adminRestrictionAge": "Age limit",
  "@adminRestrictionAge": {
    "description": "Label over the age bound. Shown as a range with an open end where only one side was set."
  },
  "adminRestrictionGender": "Gender limit",
  "@adminRestrictionGender": {
    "description": "Label over the gender bound — a dictionary id resolved to a label (BR-13)."
  },
  "adminRestrictionReason": "Reason the employer chose",
  "@adminRestrictionReason": {
    "description": "Label over the BR-12 justification the employer picked from the enumerated list — the thing §10.2 actually asks a moderator to judge."
  },
  "adminRestrictionNote": "In their own words",
  "@adminRestrictionNote": {
    "description": "Label over the employer's own elaboration, shown verbatim (§2.4). A moderator judging a paraphrase would be judging something the employer did not say."
  },
  "adminPreviousReason": "Sent back before, for this",
  "@adminPreviousReason": {
    "description": "This vacancy has been round the loop before. Worth showing: a second rejection for the same thing means the first reason did not land, which is the moderator's problem to fix rather than repeat."
  },
  "adminVacancyWhere": "Where the work is",
  "@adminVacancyWhere": {
    "description": "Heading over region, district and street address on the review."
  },
  "adminVacancyEmployer": "Employer",
  "@adminVacancyEmployer": {
    "description": "Heading over the employer name and contact block on §10.2’s vacancy review. The card renders only where the server sent at least one of the three fields, which today is never — see the backend ask in TODO.md."
  },
  "adminVacancyEmployerPhone": "Sign-in number",
  "@adminVacancyEmployerPhone": {
    "description": "The *account* number (§4.1), not a contact detail — kept beside the published one because it is §10.4’s user-search key, so a moderator who wants this employer’s whole history has the string to paste. Drawn only when it differs from the contact number: one number under two labels reads as a data error."
  },
  "adminComplaintsTitle": "Complaints",
  "@adminComplaintsTitle": {
    "description": "§10.2’s third queue. One list over all four target kinds, because the server made complaints a single generic table for exactly that."
  },
  "adminComplaintsEmpty": "Nothing reported",
  "@adminComplaintsEmpty": {
    "description": "Empty state for the complaint queue."
  },
  "adminComplaintsEmptyBody": "No complaint is waiting for a decision.",
  "@adminComplaintsEmptyBody": {
    "description": "Says the queue is empty rather than broken."
  },
  "adminComplaintKindVacancy": "Vacancy",
  "@adminComplaintKindVacancy": {
    "description": "The complaint’s target kind. A meta chip rather than a badge: every complaint in this queue has the same *status*, open, and the kind is a classification — drawing it as a badge would spend the status vocabulary on something that is not a status."
  },
  "adminComplaintKindUser": "Person",
  "@adminComplaintKindUser": {
    "description": "Target kind. \"Person\" rather than \"user\" because the reported thing is somebody, and the remedy is aimed at them."
  },
  "adminComplaintKindProfile": "Profile",
  "@adminComplaintKindProfile": {
    "description": "Target kind. Kept distinct from \"person\" because the reporter chose between the two and the audit trail keeps the choice — even though the server resolves both to the same row."
  },
  "adminComplaintKindMessage": "Message",
  "@adminComplaintKindMessage": {
    "description": "Target kind. The remedy for a reported message is aimed at its sender: nothing edits or removes a message, because §7’s chat history is evidence."
  },
  "adminComplaintKindUnknown": "Unknown type",
  "@adminComplaintKindUnknown": {
    "description": "A target kind this build does not know. The row still draws — throwing on one unrecognised value would take the whole queue down."
  },
  "adminComplaintKindUnknownBody": "This version of the app cannot show what kind of thing this is. Update the app to review it.",
  "@adminComplaintKindUnknownBody": {
    "description": "Shown in place of the target card for an unrecognised kind. Says what to do rather than showing an empty card."
  },
  "adminComplaintTitle": "Complaint",
  "@adminComplaintTitle": {
    "description": "App bar on §10.2’s complaint review."
  },
  "adminComplaintGoneTitle": "This complaint is gone",
  "@adminComplaintGoneTitle": {
    "description": "Title for a 404 complaint.not_found. Usually a colleague reviewed it first, so it gets a notice and a way back rather than a retry that would fail identically."
  },
  "adminComplaintGoneBody": "Somebody reviewed it, or it never existed. There is nothing left to decide.",
  "@adminComplaintGoneBody": {
    "description": "Both causes of a 404, because the administrator cannot tell them apart and neither needs a different action."
  },
  "adminComplaintReported": "What was reported",
  "@adminComplaintReported": {
    "description": "Heading over the reporter’s own words, shown verbatim (§2.4). The list clips them; this screen does not."
  },
  "adminComplaintTarget": "The reported item",
  "@adminComplaintTarget": {
    "description": "Heading over the resolved target — the vacancy, the person, or the message itself."
  },
  "adminComplaintTargetGone": "The reported item is gone",
  "@adminComplaintTargetGone": {
    "description": "A null target, which is a normal state: the server keeps a complaint past the life of what it was about, so the record of a decision survives the decision."
  },
  "adminComplaintTargetGoneBody": "It was removed after the complaint was filed. The complaint is kept, so the outcome can still be recorded.",
  "@adminComplaintTargetGoneBody": {
    "description": "Says why the target is missing and that the decision is still worth recording — dismissing a complaint about a deleted vacancy is exactly what should happen to it."
  },
  "adminComplaintEmployerAccount": "Employer account",
  "@adminComplaintEmployerAccount": {
    "description": "Stands in for a missing name on a person target. Not \"no name\": the server’s join is against candidate_profiles, so an employer resolves to a status and nothing else, and saying which beats an empty line."
  },
  "adminComplaintRemedy": "Act on it first",
  "@adminComplaintRemedy": {
    "description": "Heading over the target actions. Above the outcome on purpose: recording a complaint as upheld does not carry anything out, and the two are separate requests the client cannot make atomic."
  },
  "adminComplaintRemedyBody": "Recording a complaint as upheld does not carry anything out. Do that here first.",
  "@adminComplaintRemedyBody": {
    "description": "The load-bearing sentence of the screen: an actioned complaint with no action taken is true about the record and false about the world."
  },
  "adminComplaintNoRemedy": "There is nothing to act on from here. Record the outcome below.",
  "@adminComplaintNoRemedy": {
    "description": "Rendered rather than hiding the section: a moderator who cannot find the remedy assumes they missed it. Covers a gone target and a vacancy already closed — closed is terminal (BR-11), so no status change is left."
  },
  "adminComplaintOutcome": "Record the outcome",
  "@adminComplaintOutcome": {
    "description": "Heading over uphold/dismiss."
  },
  "adminComplaintOutcomeBody": "Nothing else records a complaint review, so what you write is the whole account of it.",
  "@adminComplaintOutcomeBody": {
    "description": "Why the resolution is mandatory on both outcomes: unlike a verification decision there is no BR-08 status row standing behind it, so the audit entry is the only record."
  },
  "adminComplaintUphold": "Uphold",
  "@adminComplaintUphold": {
    "description": "The actioned outcome. Deliberately not \"resolve\": it claims something was done."
  },
  "adminComplaintDismiss": "Dismiss",
  "@adminComplaintDismiss": {
    "description": "The dismissed outcome."
  },
  "adminComplaintUpholdTitle": "Uphold this complaint?",
  "@adminComplaintUpholdTitle": {
    "description": "Confirmation title."
  },
  "adminComplaintUpholdBody": "It closes as upheld. If a remedy was needed, apply it before recording this.",
  "@adminComplaintUpholdBody": {
    "description": "Restates the ordering at the point of no return, because this is the sheet where an administrator in a hurry skips the remedy."
  },
  "adminComplaintDismissTitle": "Dismiss this complaint?",
  "@adminComplaintDismissTitle": {
    "description": "Confirmation title."
  },
  "adminComplaintDismissBody": "It closes with nothing done. Say why — this is the only account of the decision.",
  "@adminComplaintDismissBody": {
    "description": "A dismissal is the contested half of the two, which is why the server makes the resolution mandatory on both."
  },
  "adminResolutionLabel": "Resolution (kept in the audit log)",
  "@adminResolutionLabel": {
    "description": "Overrides the default reason label, whose parenthesis promises the *employer* reads the text verbatim. Nothing shows a resolution to the reporter, and a label naming the wrong audience is worse than a generic one."
  },
  "adminResolutionHint": "The vacancy was paused and the employer asked to take the phone number out of the description",
  "@adminResolutionHint": {
    "description": "An example that shows the field records both the finding and the remedy. An administrator given an empty box writes one word."
  },
  "adminPauseVacancy": "Pause this vacancy",
  "@adminPauseVacancy": {
    "description": "§10.2’s \"pause a vacancy with an audit record\", on a vacancy that is already published — the route nothing in the app could reach until the complaint queue existed. Offered only from `active`, per the transition table."
  },
  "adminCloseVacancy": "Remove this vacancy",
  "@adminCloseVacancy": {
    "description": "§10.2’s \"remove a vacancy\". \"Remove\" rather than \"close\": an employer closes their own vacancy, and this is somebody else doing it to them."
  },
  "adminPauseVacancyTitle": "Pause this vacancy?",
  "@adminPauseVacancyTitle": {
    "description": "Confirmation title."
  },
  "adminPauseVacancyBody": "It leaves the feed now, and can be resumed once the employer has fixed it.",
  "@adminPauseVacancyBody": {
    "description": "Names the reversibility, which is what makes a pause the proportionate answer while something is being checked."
  },
  "adminCloseVacancyTitle": "Remove this vacancy?",
  "@adminCloseVacancyTitle": {
    "description": "Confirmation title."
  },
  "adminCloseVacancyBody": "It leaves the feed for good. A removed vacancy cannot be reopened — pause it instead if the employer can fix it.",
  "@adminCloseVacancyBody": {
    "description": "BR-11 makes closed terminal, so the sheet says so and points at the reversible action instead. The one confirmation on this screen that cannot be undone."
  },
  "adminWarnUser": "Warn this person",
  "@adminWarnUser": {
    "description": "§10.4’s mild remedy, reachable from a complaint because it is what an upheld complaint about a person most often deserves. Restrict and block need an until-date and land with §10.4’s own screen."
  },
  "adminWarnUserTitle": "Send a warning?",
  "@adminWarnUserTitle": {
    "description": "Confirmation title."
  },
  "adminWarnUserBody": "Their account is not changed. The warning and its reason are recorded, and they are told.",
  "@adminWarnUserBody": {
    "description": "Says exactly what a warning does and does not do: the audit row *is* the record, which is the clearest answer to why an audit log exists when six tables already record status changes."
  },
  "adminWarnReasonLabel": "Warning (they read it word for word)",
  "@adminWarnReasonLabel": {
    "description": "The person, not the employer, is who reads this one — which is why the sheet takes a label override at all."
  },
  "adminWarnReasonHint": "Contact details in a public vacancy description are not allowed — please take them out",
  "@adminWarnReasonHint": {
    "description": "An example addressed to the person and actionable, because a warning they cannot act on is a warning that changes nothing."
  },
  "adminAccountStatusActive": "Active",
  "@adminAccountStatusActive": {
    "description": "An account in good standing. Badge, not colour alone — check-circle, the glyph that means a person was accepted."
  },
  "adminAccountStatusRestricted": "Restricted",
  "@adminAccountStatusRestricted": {
    "description": "§4.2’s restricted account. Warning-toned rather than error-toned: some actions are refused at the point of use, which is not a lockout."
  },
  "adminAccountStatusBlocked": "Blocked",
  "@adminAccountStatusBlocked": {
    "description": "BR-10’s blocked account. x-circle, the glyph that means a negative outcome with a reason always attached."
  },
  "adminVacancyEmployerContactPhone": "Contact number",
  "@adminVacancyEmployerContactPhone": {
    "description": "The number the employer published for their company (§6.1), and the one to call. Leads the card: it is what they chose to be reached on, and §6.1 makes it mandatory for a complete profile, so BR-03 guarantees a vacancy that reached review has one."
  },
  "adminUsersTitle": "Users",
  "@adminUsersTitle": {
    "description": "§10.4's tab title."
  },
  "adminUserSearchPhone": "Phone number",
  "@adminUserSearchPhone": {
    "description": "The phone filter. Never worded as \"starts with\": the server matches a substring, which is how a number is remembered."
  },
  "adminUserSearchPhoneHint": "The last digits are enough",
  "@adminUserSearchPhoneHint": {
    "description": "Says the match is a substring without using the word."
  },
  "adminUserSearchPhoneTooShort": "At least 3 digits.",
  "@adminUserSearchPhoneTooShort": {
    "description": "The server's own minimum (3), restated so the search stops before a 400 rather than after one."
  },
  "adminUserSearchName": "Name",
  "@adminUserSearchName": {
    "description": "The name filter. Matched against five columns, so the label must not name one kind of account."
  },
  "adminUserSearchNameHint": "A person, a company, or its legal name",
  "@adminUserSearchNameHint": {
    "description": "Names the five columns without listing them: a person, a company, a legal name."
  },
  "adminUserSearchNameTooShort": "At least 2 characters.",
  "@adminUserSearchNameTooShort": {
    "description": "The server's own minimum (2)."
  },
  "adminUserSearchMore": "More filters",
  "@adminUserSearchMore": {
    "description": "Opens the role, status and registration-date filters."
  },
  "adminUserSearchFewer": "Fewer filters",
  "@adminUserSearchFewer": {
    "description": "Closes them again."
  },
  "adminUserSearchRole": "Holds the role",
  "@adminUserSearchRole": {
    "description": "\"Holds\", never \"is\": §2.3 lets one account hold several roles, so a candidate who also employs matches either."
  },
  "adminUserSearchStatus": "Account status",
  "@adminUserSearchStatus": {
    "description": "The account-status filter. Exact match, unlike the two text ones."
  },
  "adminUserSearchRegisteredFrom": "Registered from",
  "@adminUserSearchRegisteredFrom": {
    "description": "Inclusive, a calendar date in the platform zone."
  },
  "adminUserSearchRegisteredTo": "Registered to",
  "@adminUserSearchRegisteredTo": {
    "description": "Inclusive too, so the same day in both means that one day."
  },
  "adminUserSearchDatesReversed": "These dates cannot match",
  "@adminUserSearchDatesReversed": {
    "description": "A range that can match nothing — the one filter mistake the server answers with an empty list rather than a refusal, which is the answer hardest to tell from \"this person does not exist\"."
  },
  "adminUserSearchDatesReversedBody": "The first date is after the second, so no account can fall between them.",
  "@adminUserSearchDatesReversedBody": {
    "description": "Says why, in the terms the administrator set them in."
  },
  "adminUserSearchRun": "Search",
  "@adminUserSearchRun": {
    "description": "Runs the search. Disabled while a filter holds something the server would refuse."
  },
  "adminUserSearchClear": "Clear the filters",
  "@adminUserSearchClear": {
    "description": "Empties every filter. Shown only when there is something to clear."
  },
  "adminUserSearchIdle": "Find an account",
  "@adminUserSearchIdle": {
    "description": "Before any search has been run. Not the same state as \"nothing matches\", and §11.1 is why it exists: nothing is fetched until an administrator asks."
  },
  "adminUserSearchIdleBody": "Search by the last digits of a phone number, or by any name the account is known under — a person's, a company's public name, or its legal name. Nothing is looked up until you ask.",
  "@adminUserSearchIdleBody": {
    "description": "Says what the two fields match, and that nothing is read until asked."
  },
  "adminUserSearchEmpty": "No account matches",
  "@adminUserSearchEmpty": {
    "description": "A search that matched nothing. Deliberately not \"no such user\": paging makes those two easy to confuse."
  },
  "adminUserSearchEmptyBody": "Nothing matches these filters. A phone number is matched anywhere inside it, so the last few digits find an account that a full number typed differently will not.",
  "@adminUserSearchEmptyBody": {
    "description": "Points at the substring match, which is what finds an account a fully typed number can miss."
  },
  "adminUserSearchOrder": "Newest registration first. An older account is further down the list rather than missing — narrow the search instead of paging to it.",
  "@adminUserSearchOrder": {
    "description": "Shown only when the page is full. Results are newest registration first, so an old account matching a broad filter sits past the page rather than outside the filter — and from the client those look identical."
  },
  "adminUserNoName": "No name on the account",
  "@adminUserNoName": {
    "description": "The server resolves a name from five columns, so null means the account has none anywhere yet — not that it is anonymous."
  },
  "adminUserNoPhone": "No phone number",
  "@adminUserNoPhone": {
    "description": "The DTO admits a null phone, so the row says so rather than drawing an empty line."
  },
  "adminUserRegistered": "Registered {date}",
  "@adminUserRegistered": {
    "description": "When the account was created, as a calendar day in the platform zone.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "adminUserLastLogin": "Last signed in {date}",
  "@adminUserLastLogin": {
    "description": "The last sign-in.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "adminUserNeverSignedIn": "Never signed in",
  "@adminUserNeverSignedIn": {
    "description": "An account that has never signed in — what tells a stalled registration from an abandoned account."
  },
  "adminAccountStatusDeletionRequested": "Deletion requested",
  "@adminAccountStatusDeletionRequested": {
    "description": "BR-14's own state. Neutral rather than warning-toned: it is not a sanction, and no administrator action applies to it."
  },
  "adminUserTitle": "Account",
  "@adminUserTitle": {
    "description": "§10.4's user screen."
  },
  "adminUserGoneTitle": "This account is gone",
  "@adminUserGoneTitle": {
    "description": "`user.not_found`. Retrying fails the same way, so there is no retry."
  },
  "adminUserGoneBody": "It was not found. It may have been deleted since the search that found it.",
  "@adminUserGoneBody": {
    "description": "Says the likeliest reason without asserting it."
  },
  "adminUserActions": "Act on this account",
  "@adminUserActions": {
    "description": "§10.4's four actions."
  },
  "adminUserNoActionsTitle": "Nothing can be done from here",
  "@adminUserNoActionsTitle": {
    "description": "A `deletion_requested` account. Rendered rather than hidden: an administrator who cannot find the buttons assumes they missed them."
  },
  "adminUserNoActionsBody": "This account has asked to be deleted. That request is answered by its own process, and restricting or blocking it here would overwrite the request.",
  "@adminUserNoActionsBody": {
    "description": "BR-14 owns the state, and the server refuses every transition out of it — a block that overwrote the request would lose it."
  },
  "adminUserRestrict": "Restrict",
  "@adminUserRestrict": {
    "description": "§10.4's restriction: some actions refused, the account kept."
  },
  "adminUserBlock": "Block",
  "@adminUserBlock": {
    "description": "BR-10's block. Destructive-toned, and the only action on this screen that is."
  },
  "adminUserUnblock": "Unblock",
  "@adminUserUnblock": {
    "description": "Lifting a block. Same transition as lifting a restriction, different sentence — \"unblock\" says nothing to somebody looking at a restricted account."
  },
  "adminUserLiftRestriction": "Lift the restriction",
  "@adminUserLiftRestriction": {
    "description": "Lifting a restriction."
  },
  "adminUserRestrictTitle": "Restrict this account?",
  "@adminUserRestrictTitle": {
    "description": "Confirmation."
  },
  "adminUserRestrictBody": "They keep the account and can still sign in, but every action that changes anything is refused until it is lifted. They are shown your reason.",
  "@adminUserRestrictBody": {
    "description": "States what a restriction actually does — §4.2 refuses actions at the point of use rather than locking the account out — and that the reason is shown to them."
  },
  "adminUserBlockTitle": "Block this account?",
  "@adminUserBlockTitle": {
    "description": "Confirmation."
  },
  "adminUserBlockBody": "They lose access to everything but the notice explaining why. Only an administrator can undo it.",
  "@adminUserBlockBody": {
    "description": "BR-10: a blocked account reaches nothing but the notice, and the notice is the reason typed here."
  },
  "adminUserUnblockTitle": "Unblock this account?",
  "@adminUserUnblockTitle": {
    "description": "Confirmation."
  },
  "adminUserLiftRestrictionTitle": "Lift this restriction?",
  "@adminUserLiftRestrictionTitle": {
    "description": "Confirmation."
  },
  "adminUserLiftBody": "Everything is available to them again from now.",
  "@adminUserLiftBody": {
    "description": "One sentence for both, because the outcome is the same: the account is active again."
  },
  "adminUserRestrictUntilLabel": "Ends on",
  "@adminUserRestrictUntilLabel": {
    "description": "§10.4's optional restriction end date."
  },
  "adminUserRestrictUntilCaption": "The restriction lifts at the start of this day, Tashkent time. Leave it empty and it stays until an administrator lifts it.",
  "@adminUserRestrictUntilCaption": {
    "description": "Says which end of the day it is — BR-10's guard lifts the restriction once the instant passes, and the client sends the start of the chosen day — and what leaving it empty means."
  },
  "adminUserStatusReasonLabel": "Reason (they read it word for word)",
  "@adminUserStatusReasonLabel": {
    "description": "BR-10 requires the app to explain a restriction rather than fail mysteriously, and §4.2 shows this text to the account verbatim — so the label promises the right audience."
  },
  "adminUserStatusReasonHint": "Repeatedly posting vacancies that ask candidates for money",
  "@adminUserStatusReasonHint": {
    "description": "An example that is a reason rather than a label."
  },
  "adminUserRestrictedUntil": "Restricted until {date}",
  "@adminUserRestrictedUntil": {
    "description": "When a restriction lifts. The day is inclusive of nothing: the guard clears it at the start of it.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "adminUserRestrictedIndefinitely": "Restricted until an administrator lifts it",
  "@adminUserRestrictedIndefinitely": {
    "description": "A restriction with no end date — a different fact from one that expires, and the one an administrator needs before deciding whether to act."
  },
  "adminUserHistory": "Account history",
  "@adminUserHistory": {
    "description": "BR-08's account status trail — half of §10.4's \"relevant moderation history\"."
  },
  "adminUserHistoryEmpty": "Nothing has changed this account's status.",
  "@adminUserHistoryEmpty": {
    "description": "An account whose status has never moved."
  },
  "adminUserHistoryBy": "By {actor}",
  "@adminUserHistoryBy": {
    "description": "Who made the change.",
    "placeholders": {
      "actor": {
        "type": "String"
      }
    }
  },
  "adminUserHistoryAutomatic": "By the platform, when the date passed",
  "@adminUserHistoryAutomatic": {
    "description": "A row with no actor: BR-10's guard lifting an expired restriction. The difference between a decision and a deadline is worth keeping on screen."
  },
  "adminUserComplaints": "Complaints about this account",
  "@adminUserComplaints": {
    "description": "Complaints filed about this account — the other half of §10.4's moderation history."
  },
  "adminUserComplaintsEmpty": "Nobody has reported this account.",
  "@adminUserComplaintsEmpty": {
    "description": "Nobody has reported them."
  },
  "adminUserComplaintOpen": "Open",
  "@adminUserComplaintOpen": {
    "description": "A complaint still awaiting §10.2's decision. A meta chip rather than a badge: this list mixes open and decided ones, and the classification is not the account's status."
  },
  "adminUserComplaintClosed": "Reviewed",
  "@adminUserComplaintClosed": {
    "description": "A complaint somebody has already decided, upheld or dismissed alike — which one is the review's business, not this list's."
  },
  "adminAuditTitle": "Audit log",
  "@adminAuditTitle": {
    "description": "§10.4's immutable log."
  },
  "adminAuditNote": "Newest first. Nothing here can be changed or removed.",
  "@adminAuditNote": {
    "description": "Said once at the top. Not decoration: a log that could be edited would not be one, and the immutability is a property of the table rather than of this app having no write path."
  },
  "adminAuditEmpty": "Nothing recorded yet",
  "@adminAuditEmpty": {
    "description": "No rows at all."
  },
  "adminAuditEmptyBody": "An entry appears here whenever an administrator decides, verifies, moderates or sanctions something.",
  "@adminAuditEmptyBody": {
    "description": "The unfiltered log, empty. Says what would put a row here."
  },
  "adminAuditEmptyFilteredBody": "Nothing has been recorded for this one. The rest of the log is below.",
  "@adminAuditEmptyFilteredBody": {
    "description": "The filtered log, empty. A different sentence from the unfiltered one: here the log is not empty, this slice of it is."
  },
  "adminAuditFilteredByActor": "Only this administrator",
  "@adminAuditFilteredByActor": {
    "description": "§10.4's first question: what has this administrator done."
  },
  "adminAuditFilteredByTarget": "Only this record",
  "@adminAuditFilteredByTarget": {
    "description": "§10.4's other question: what was done to this thing."
  },
  "adminAuditShowAll": "Show the whole log",
  "@adminAuditShowAll": {
    "description": "Back to the unfiltered log. The only control on the screen, because every filter this endpoint takes is a uuid and there is nothing useful to type."
  },
  "adminAuditActor": "Administrator",
  "@adminAuditActor": {
    "description": "Who wrote the row. The id beside it is not resolved to a name — see the screen doc — and the row opens that account instead."
  },
  "adminAuditDetails": "What changed",
